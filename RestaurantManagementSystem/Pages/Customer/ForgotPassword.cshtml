@page
@model RestaurantManagementSystem.Pages.Customer.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_CustomerAuthLayout";
}

<h1>Forgot password</h1>
<p class="md-auth-subtitle">Enter the email you registered with and we'll send you a 6-digit code</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="md-alert-danger mb-4" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="mb-4">
        <label class="md-label" asp-for="Email">Email address</label>
        <input class="form-control md-input" asp-for="Email" type="email"
               placeholder="you@example.com" autocomplete="email" required autofocus />
    </div>

    <button type="submit" class="btn btn-md-dark w-100">Send code</button>
</form>

<p class="md-auth-switch">Remembered it? <a asp-page="/Customer/Login">Back to sign in</a></p>