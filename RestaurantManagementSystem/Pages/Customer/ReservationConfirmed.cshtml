@page
@model RestaurantManagementSystem.Pages.Customer.ReservationConfirmedModel
@{
    // Example data – later from the Reservation (reservationStatus). New bookings start as "Pending"
    // until staff confirm. UI preview only: /Customer/ReservationConfirmed?status=Confirmed shows the
    // confirmed version – the backend replaces this with the real status (don't read it from the URL).
    var status = Request.Query["status"] == "Confirmed" ? "Confirmed" : "Pending";
    var isPending = status == "Pending";
    var code = "R-0048";   // backend: "R-" + reservationID.ToString("0000")

    ViewData["Title"] = isPending ? "Booking received" : "Booking confirmed";
    ViewData["ActiveNav"] = "Reservations";
    ViewData["Eyebrow"] = "Reservation";
    ViewData["Heading"] = isPending ? "Booking received" : "Booking confirmed";
    Layout = "_CustomerLayout";
}

<div class="md-confirm-wrap md-section">
    <section class="md-card" id="confirmationCard">
        <div class="md-card-header">
            <span class="md-card-label">Reservation confirmation</span>
            <span class="md-card-meta">Issued 16 Sep 2026, 20:41</span>
        </div>
        <div class="md-card-body md-confirm">
            @if (isPending)
            {
                <span class="md-badge md-badge-pending">Pending</span>
                <h2 class="md-confirm-title">Booking received</h2>
                <p class="md-confirm-ref">Reference <b>@code</b> · we'll notify you as soon as our team confirms it.</p>
            }
            else
            {
                <span class="md-badge md-badge-confirmed">Confirmed</span>
                <h2 class="md-confirm-title">Your table is booked</h2>
                <p class="md-confirm-ref">Reference <b>@code</b> · confirmation sent to alexandra@example.com</p>
            }

            <dl class="md-confirm-facts">
                <div><dt>Date</dt><dd>Sunday, 27 September 2026</dd></div>
                <div><dt>Time</dt><dd>19:00 – 20:30</dd></div>
                <div><dt>Guests</dt><dd>4</dd></div>
                <div><dt>Table</dt><dd><i class="bi bi-lamp md-lamp" aria-hidden="true"></i>T-14 · Outdoor</dd></div>
                <div><dt>Name</dt><dd>Alexandra Beaumont</dd></div>
                <div><dt>Special request</dt><dd>Celebrating a birthday · Window seat</dd></div>
            </dl>

            <p class="md-note-box mt-0">Free cancellation until 17:00 on 27 September. Please arrive within 15 minutes of your booking time.</p>

            @* data-html2canvas-ignore: the buttons are left out of the PDF *@
            <div class="md-confirm-actions" data-html2canvas-ignore>
                @* Downloads the card above as a PDF (wwwroot/js/pdf-download.js) – the file name comes from the reservation code *@
                <button type="button" class="btn btn-md-dark" data-pdf-target="#confirmationCard" data-pdf-name="MaisonDoree-Reservation-@code"><i class="bi bi-download me-2"></i>Download confirmation (PDF)</button>
                <a class="btn btn-md-outline" href="/Customer/Reservations">View my reservations</a>
            </div>
        </div>
    </section>

    @if (isPending)
    {
        <p class="md-confirm-foot">Bookings are confirmed by our team, usually within 2 hours. You'll find this booking under Reservations.</p>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-download.js" asp-append-version="true"></script>
}
