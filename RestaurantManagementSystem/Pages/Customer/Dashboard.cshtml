@page
@model RestaurantManagementSystem.Pages.Customer.DashboardModel
@using RestaurantManagementSystem.Helpers
@using RestaurantManagementSystem.Services
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var hour = DateTime.Now.Hour;

    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "Overview";
    ViewData["Eyebrow"] = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    ViewData["Heading"] = HttpContext.Session.GetUserName() ?? "Welcome";
    Layout = "_CustomerLayout";

    // Next reservations card: the customer's Pending / Confirmed / Seated reservations in the next 7 days, soonest first
    // (DashboardModel.NextReservations). The card always has two slots:
    //   1 reservation → top slot filled, bottom slot left blank · 2 → both slots · 3 or more → the slots scroll inside the card.
    var nextReservations = Model.NextReservations.Select(r => (
        Code: ReservationService.Code(r),
        Status: r.reservationStatus,
        Month: r.reservationDateTime.ToString("MMM", inv),
        Day: r.reservationDateTime.ToString("dd", inv),
        DayText: DayText(r.reservationDateTime),
        Time: r.reservationDateTime.ToString("h:mm tt", inv),
        Guests: r.partySize,
        Table: r.DiningTable?.tableNumber + " · " + r.DiningTable?.DiningArea?.areaName
    )).ToList();
}

@functions {
    // "Tonight" / "Tomorrow evening" / "Sunday evening" (same wording as the Reservations page)
    static string DayText(DateTime start)
    {
        var part = start.Hour < 16 ? "lunch" : "evening";
        if (start.Date == DateTime.Today) return start.Hour < 16 ? "Today, lunch" : "Tonight";
        if (start.Date == DateTime.Today.AddDays(1)) return "Tomorrow " + part;
        return start.ToString("dddd", System.Globalization.CultureInfo.InvariantCulture) + " " + part;
    }
}

