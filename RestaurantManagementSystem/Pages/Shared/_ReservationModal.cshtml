@* Reservation details pop-up (same style as the notification pop-up).
   Opened by any button with data-bs-toggle="modal" data-bs-target="#reservationModal".
   Example data – fill from the Reservation (and its DiningTable / Customer) later. *@
<div class="modal fade md-modal" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow">Reservation</span>
                    <h2 class="modal-title md-modal-title" id="reservationModalTitle">R-0041</h2>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="md-badge md-badge-confirmed">Confirmed</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <dl class="md-detail-list">
                    <dt>Date</dt>            <dd>Sunday, 20 September 2026</dd>
                    <dt>Time</dt>            <dd>19:30 · about 90 minutes</dd>
                    <dt>Guests</dt>          <dd>2</dd>
                    <dt>Table</dt>           <dd>T-07</dd>
                    <dt>Dining area</dt>     <dd>Indoor</dd>
                    <dt>Special request</dt> <dd>Quiet table away from the entrance, if available.</dd>
                    <dt>Dining preference</dt><dd>None</dd>
                    <dt>Booked on</dt>       <dd>14 Sep 2026, 21:12</dd>
                    <dt>Name</dt>            <dd>Alexandra Beaumont</dd>
                    <dt>Contact</dt>         <dd>alexandra@example.com · 0123456789</dd>
                </dl>
                <p class="md-modal-note">Free cancellation until 17:30 on the day of your visit.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-md-outline" data-bs-dismiss="modal">Close</button>
                <a class="btn btn-md-dark" href="/Customer/EditReservation">Modify reservation</a>
            </div>
        </div>
    </div>
</div>