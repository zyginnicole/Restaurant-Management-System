@* Shared notification pop-up. Used by the Customer Overview and Notifications pages.
   It is filled in by wwwroot/js/notifications.js from the clicked item's data-* values. *@
<div class="modal fade md-modal" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow" id="notificationModalType">Notification</span>
                    <h2 class="modal-title md-modal-title" id="notificationModalTitle">Notification</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="md-modal-message" id="notificationModalMessage"></p>
                <span class="md-notice-time" id="notificationModalTime"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-md-outline" data-bs-dismiss="modal">Close</button>
                <a class="btn btn-md-dark d-none" id="notificationModalLink" href="#">View</a>
            </div>
        </div>
    </div>
</div>
