@page
@model RestaurantManagementSystem.Pages.ErrorModel
@{
    // Shared error page (Layout = null, so it still shows if a layout is broken).
    //   404 → wrong URL or return NotFound();            → "Page not found"
    //   500 → unhandled exception (outside Development)  → "Something went wrong" + reference ID
    // Same design and buttons for both; only the heading and message change.
    // See ErrorModel (Error.cshtml.cs) for the Program.cs set-up and when to use each one.
    ViewData["Title"] = Model.IsNotFound ? "Page not found" : "Something went wrong";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @ViewData["Brand"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="md-error">
        <div class="md-error-card">
            <span class="md-eyebrow">@ViewData["Brand"]</span>
            @* 404: the page or record doesn't exist. Otherwise: an unexpected error. *@
            @if (Model.IsNotFound)
            {
                <h1>Page not found</h1>
                <p>The page you're looking for doesn't exist or may have moved. Check the address, or go back to the previous page.</p>
            }
            else
            {
                <h1>Something went wrong</h1>
                <p>We couldn't complete your request. Please try again in a moment, or go back to the previous page.</p>
            }

            @* Reference ID only for real errors – a missing page has nothing to look up in the server log *@
            @if (!Model.IsNotFound && Model.ShowRequestId)
            {
                <p class="md-error-ref">Reference: <code>@Model.RequestId</code></p>
            }

            <div class="md-error-actions">
                <button type="button" class="btn btn-md-outline" onclick="history.back()">Go back</button>
                <a class="btn btn-md-dark" href="/">Return to home</a>
            </div>
        </div>
    </main>
</body>
</html>
