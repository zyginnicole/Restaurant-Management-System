@page
@model RestaurantManagementSystem.Pages.Admin.SettingsModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Settings";
    ViewData["Module"] = "Admin";
    ViewData["ActiveNav"] = "Settings";
    ViewData["Subtitle"] = "Reservation rules, billing and security for the whole system";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-setup.css" asp-append-version="true" />
}

<div class="a-settings">

    <nav class="a-subnav" role="tablist" aria-label="Settings sections">
        <button type="button" class="active" role="tab" data-bs-toggle="pill" data-bs-target="#set-general"><i class="bi bi-shop"></i>General</button>
        <button type="button" role="tab" data-bs-toggle="pill" data-bs-target="#set-reservations"><i class="bi bi-calendar3"></i>Reservations</button>
        <button type="button" role="tab" data-bs-toggle="pill" data-bs-target="#set-billing"><i class="bi bi-credit-card"></i>Billing &amp; payments</button>
        <button type="button" role="tab" data-bs-toggle="pill" data-bs-target="#set-security"><i class="bi bi-shield-lock"></i>Security</button>
    </nav>

    <form method="post" autocomplete="off">
        <input type="hidden" asp-for="Tab" />
        <div class="tab-content">

            @* ================= General ================= *@
            <div class="tab-pane fade show active" id="set-general" role="tabpanel">
                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Restaurant details</h2></div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Restaurant name</div><div class="a-setting-hint">Shown on receipts and customer pages</div></div>
                        <input asp-for="S.restaurantName" class="form-control a-input" aria-label="Restaurant name" />
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Tagline</div><div class="a-setting-hint">Appears under the name in the sidebar</div></div>
                        <input asp-for="S.tagline" class="form-control a-input" aria-label="Tagline" />
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Phone</div></div>
                        <input asp-for="S.phone" class="form-control a-input" aria-label="Phone" />
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Email</div><div class="a-setting-hint">Where reservation enquiries are sent</div></div>
                        <input asp-for="S.email" type="email" class="form-control a-input" aria-label="Email" />
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Address</div></div>
                        <textarea asp-for="S.address" class="form-control a-input" rows="2" aria-label="Address"></textarea>
                    </div>
                    <div class="a-setting">
                        @* Read-only: the system's time rules run on Malaysia time (server clock, GMT+8) – see ReservationService *@
                        <div><div class="a-setting-label">Time zone</div><div class="a-setting-hint">All bookings and schedules use Malaysia time</div></div>
                        @* Not clickable or focusable (pointer-events / tabindex); readonly so the value is still saved with the form *@
                        <input asp-for="S.timeZone" value="(GMT+8) Kuala Lumpur, Penang" class="form-control a-input" readonly tabindex="-1" style="pointer-events: none;" aria-label="Time zone" />
                    </div>
                </section>
            </div>

            @* ================= Reservations ================= *@
            <div class="tab-pane fade" id="set-reservations" role="tabpanel">
                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Reservation rules</h2></div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Dining duration</div><div class="a-setting-hint">How long a table is held for each booking</div></div>
                        <select asp-for="S.diningMinutes" class="form-select a-input" aria-label="Dining duration"><option value="60">60 minutes</option><option value="90">90 minutes</option><option value="120">120 minutes</option><option value="150">150 minutes</option></select>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Party size</div><div class="a-setting-hint">Smallest and largest group a guest can book online</div></div>
                        <div class="input-group">
                            <input asp-for="S.minPartySize" type="number" class="form-control a-input" min="1" aria-label="Minimum party size" />
                            <span class="input-group-text">to</span>
                            <input asp-for="S.maxPartySize" type="number" class="form-control a-input" min="1" aria-label="Maximum party size" />
                        </div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Booking window</div><div class="a-setting-hint">How far ahead guests can reserve</div></div>
                        <div class="input-group"><input asp-for="S.bookingWindowDays" type="number" class="form-control a-input" min="1" aria-label="Booking window in days" /><span class="input-group-text">days</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Minimum notice</div><div class="a-setting-hint">Closest a booking can be made to its start time</div></div>
                        <div class="input-group"><input asp-for="S.minNoticeHours" type="number" class="form-control a-input" min="0" aria-label="Minimum notice in hours" /><span class="input-group-text">hours</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Free cancellation window</div><div class="a-setting-hint">Guests can cancel or change without penalty until this long before arrival</div></div>
                        <div class="input-group"><input asp-for="S.cancelWindowHours" type="number" class="form-control a-input" min="0" aria-label="Cancellation window in hours" /><span class="input-group-text">hours</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Hold table for late guests</div><div class="a-setting-hint">After this the booking is marked as a no-show</div></div>
                        <div class="input-group"><input asp-for="S.lateHoldMinutes" type="number" class="form-control a-input" min="0" aria-label="Late hold in minutes" /><span class="input-group-text">minutes</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Confirm bookings automatically</div><div class="a-setting-hint">Turn off to approve each reservation manually</div></div>
                        <input asp-for="S.autoConfirm" class="a-switch" aria-label="Confirm bookings automatically" />
                    </div>
                </section>
            </div>

            @* ================= Billing & payments ================= *@
            <div class="tab-pane fade" id="set-billing" role="tabpanel">
                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Charges</h2></div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Service charge</div><div class="a-setting-hint">Added to every dine-in bill</div></div>
                        <div class="input-group"><input asp-for="S.serviceChargePct" type="number" class="form-control a-input" min="0" step="0.5" aria-label="Service charge" /><span class="input-group-text">%</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Sales and service tax (SST)</div></div>
                        <div class="input-group"><input asp-for="S.sstPct" type="number" class="form-control a-input" min="0" step="0.5" aria-label="SST" /><span class="input-group-text">%</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Receipt footer</div><div class="a-setting-hint">Printed at the bottom of every receipt</div></div>
                        <input asp-for="S.receiptFooter" class="form-control a-input" aria-label="Receipt footer" />
                    </div>
                </section>

                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Accepted payment methods</h2></div>
                    <div class="a-setting"><div><div class="a-setting-label">Cash</div></div><input asp-for="S.acceptCash" class="a-switch" aria-label="Cash" /></div>
                    <div class="a-setting"><div><div class="a-setting-label">Credit / debit card</div></div><input asp-for="S.acceptCard" class="a-switch" aria-label="Credit or debit card" /></div>
                    <div class="a-setting"><div><div class="a-setting-label">Online banking (FPX)</div></div><input asp-for="S.acceptFpx" class="a-switch" aria-label="Online banking" /></div>
                    <div class="a-setting"><div><div class="a-setting-label">E-wallet</div><div class="a-setting-hint">Touch 'n Go, GrabPay</div></div><input asp-for="S.acceptEwallet" class="a-switch" aria-label="E-wallet" /></div>
                </section>
            </div>

            @* ================= Security ================= *@
            <div class="tab-pane fade" id="set-security" role="tabpanel">
                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Password policy</h2></div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Minimum length</div></div>
                        <div class="input-group"><input asp-for="S.passwordMinLength" type="number" class="form-control a-input" min="6" aria-label="Minimum password length" /><span class="input-group-text">characters</span></div>
                    </div>
                    <div class="a-setting"><div><div class="a-setting-label">Require an uppercase letter</div></div><input asp-for="S.requireUpper" class="a-switch" aria-label="Require uppercase" /></div>
                    <div class="a-setting"><div><div class="a-setting-label">Require a number</div></div><input asp-for="S.requireNumber" class="a-switch" aria-label="Require number" /></div>
                    <div class="a-setting"><div><div class="a-setting-label">Require a symbol</div></div><input asp-for="S.requireSymbol" class="a-switch" aria-label="Require symbol" /></div>
                </section>

                <section class="a-card">
                    <div class="a-card-head"><h2 class="a-card-title">Sign-in protection</h2></div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Lock account after failed sign-ins</div><div class="a-setting-hint">The account stays locked until an administrator unlocks it</div></div>
                        <div class="input-group"><input asp-for="S.maxFailedLogins" type="number" class="form-control a-input" min="3" aria-label="Failed attempts" /><span class="input-group-text">attempts</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Sign out when inactive</div></div>
                        <div class="input-group"><input asp-for="S.idleTimeoutMinutes" type="number" class="form-control a-input" min="5" aria-label="Idle timeout in minutes" /><span class="input-group-text">minutes</span></div>
                    </div>
                    <div class="a-setting">
                        <div><div class="a-setting-label">Require two-step verification for staff</div></div>
                        <input asp-for="S.requireTwoStep" class="a-switch" aria-label="Require two-step verification" />
                    </div>
                </section>
            </div>
        </div>

        <div class="a-savebar">
            <button type="reset" class="a-btn quiet" data-toast="Changes discarded">Discard</button>
            <button type="submit" class="a-btn solid">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/AdminSetup.js" asp-append-version="true"></script>

    @* "Settings saved" (after redirect) or a validation message (same request) *@
    @if ((TempData["Toast"] ?? ViewData["Toast"]) is string toastMessage)
    {
        <script>adm.toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMessage)));</script>
    }

    <script>
        (function () {
            const field = document.getElementById('Tab');

            // Remember the open tab so it survives Save
            document.querySelectorAll('.a-subnav [data-bs-target]').forEach(btn => {
                btn.addEventListener('shown.bs.tab', () => {
                    field.value = btn.dataset.bsTarget.replace('#set-', '');
                });
            });

            // Reopen the tab after Save
            if (field.value && /^[a-z]+$/.test(field.value)) {
                const btn = document.querySelector('.a-subnav [data-bs-target="#set-' + field.value + '"]');
                if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
            }
        })();
    </script>
}
