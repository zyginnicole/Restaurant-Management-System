                            <span><i class="bi bi-person" aria-hidden="true"></i>6 <span class="visually-hidden">guests</span></span>
                        </div>
                        <div class="md-next-res-row">
                            <span><i class="bi bi-lamp md-lamp" aria-hidden="true"></i>T-20 · VIP</span>
                        </div>
                    </div>
                </div>
                @* Order | Your rating side by side, Special request underneath; label above value *@
                <dl class="md-detail-grid">
                    <div><dt>Order</dt><dd>ORD-0031 · RM 1,352.56 paid</dd></div>
                    <div><dt>Your rating</dt><dd><span class="md-rated">★★★★<span class="md-rated-off">★</span></span> “Great food, slightly slow service.”</dd></div>
                    <div class="is-wide"><dt>Special request</dt><dd>Christmas family dinner</dd></div>
                </dl>
            </template>
        </li>
    </ul>
    <p class="md-history-empty d-none" data-empty>No reservations match these filters.</p>
</section>

