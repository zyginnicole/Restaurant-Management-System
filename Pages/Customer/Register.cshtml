@page
@model RestaurantManagementSystem.Pages.Customer.RegisterModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_CustomerAuthLayout";
}

@* Bootstrap Icons (eye icon). Bootstrap CSS is already loaded by the layout, so it is not added again
   here (adding it after site.css could override the theme). Bootstrap JS is loaded by function.js if missing. *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<h1>Create account</h1>
<p class="md-auth-subtitle">Join for a refined dining experience</p>

@* ---------- Error feedback: lists every problem at the top of the form ---------- *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="md-alert-danger mb-4" role="alert">
        <strong>Please fix the following:</strong>
        <ul class="mb-0 mt-1 ps-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@* Customer fields use asp-for (Customer model). ConfirmPassword, AgreeTerms and PromoOptIn are page-only fields. *@
<form method="post">
    <div class="mb-3">
        <label class="md-label" asp-for="Customer.custName">Full name</label>
        <input class="form-control md-input" asp-for="Customer.custName" type="text"
               placeholder="Alexandra Beaumont" autocomplete="name" />
        <span class="text-danger small" asp-validation-for="Customer.custName"></span>
    </div>

    <div class="mb-3">
        <label class="md-label" asp-for="Customer.custEmail">Email address</label>
        <input class="form-control md-input" asp-for="Customer.custEmail" type="email"
               placeholder="you@example.com" autocomplete="email" />
        <span class="text-danger small" asp-validation-for="Customer.custEmail"></span>
    </div>

    <div class="mb-3">
        <label class="md-label" asp-for="Customer.custPhone">Phone number</label>
        <input class="form-control md-input" asp-for="Customer.custPhone" type="tel"
               placeholder="0123456789" maxlength="11" inputmode="numeric" autocomplete="tel" />
        <span class="text-danger small" asp-validation-for="Customer.custPhone"></span>
    </div>

    <div class="mb-3">
        <label class="md-label" asp-for="Customer.DietaryPref">Dining preferences</label>
        <select class="form-select md-input" asp-for="Customer.DietaryPref">
            <option value="None">None</option>
            <option value="Vegetarian">Vegetarian</option>
            <option value="Vegan">Vegan</option>
            <option value="Halal">Halal</option>
            <option value="Gluten-free">Gluten-free</option>
            <option value="Nut allergy">Nut allergy</option>
            <option value="Seafood allergy">Seafood allergy</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="md-label" asp-for="Customer.custPassword">Password</label>
        @* Eye button sits at the right edge, in line with the dropdown arrow above *@
        <div class="position-relative">
            <input class="form-control md-input pe-5" asp-for="Customer.custPassword" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                    style="right: .75rem; line-height: 1; font-size: 1rem;"
                    data-toggle-password="Customer_custPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <p class="md-hint">At least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol (@@ $ ! % * ? &amp;).</p>
        <span class="text-danger small" asp-validation-for="Customer.custPassword"></span>
    </div>

    @* Page-only field: not saved, only checked against the password *@
    <div class="mb-4">
        <label class="md-label" for="ConfirmPassword">Confirm password</label>
        <div class="position-relative">
            <input class="form-control md-input pe-5" id="ConfirmPassword" name="ConfirmPassword" type="password"
                   placeholder="••••••••" autocomplete="new-password" />
            <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                    style="right: .75rem; line-height: 1; font-size: 1rem;"
                    data-toggle-password="ConfirmPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
    </div>

    @* Page-only field: must be ticked *@
    <div class="form-check mb-2">
        <input class="form-check-input" id="AgreeTerms" name="AgreeTerms" type="checkbox" value="true"
               checked="@Model.AgreeTerms" />
        <label class="form-check-label" for="AgreeTerms">I agree to the Terms and Privacy Policy</label>
        <div><span class="text-danger small" asp-validation-for="AgreeTerms"></span></div>
    </div>

    @* Page-only field: optional *@
    <div class="form-check mb-4">
        <input class="form-check-input" id="PromoOptIn" name="PromoOptIn" type="checkbox" value="true"
               checked="@Model.PromoOptIn" />
        <label class="form-check-label" for="PromoOptIn">Send me promotions and member offers (optional)</label>
    </div>

    <button type="submit" class="btn btn-md-dark w-100">Create account</button>
</form>

<p class="md-auth-switch">Already a member? <a asp-page="/Customer/Login">Sign in</a></p>

@* ---------- Success pop-up (opens automatically after a successful registration) ---------- *@
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="modal fade" id="registerSuccessPopup" tabindex="-1" aria-labelledby="registerSuccessTitle"
         aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-auto-show>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center p-4">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3" id="registerSuccessTitle">Account created</h5>
                    <p class="mb-4">@successMessage</p>
                    <a class="btn btn-md-dark w-100" asp-page="/Customer/Login">Go to sign in</a>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/js/function.js" asp-append-version="true"></script>
