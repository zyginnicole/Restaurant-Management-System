@page
@model RestaurantManagementSystem.Pages.Customer.ProfileModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActiveNav"] = "Profile";
    ViewData["Eyebrow"] = "Account";
    ViewData["Heading"] = "Profile";
    Layout = "_CustomerLayout";

    // Values come from the signed-in Customer (ProfileModel.Input), or what they typed after a failed save

    // Open the Change password pop-up again when OnPostPassword returns Page() with errors
    var reopenPassword = Request.Query["handler"] == "Password" && !ViewData.ModelState.IsValid;

    // Stay in Edit mode when OnPostProfile returns Page() with errors
    var reopenEdit = Request.Query["handler"] == "Profile" && !ViewData.ModelState.IsValid;
}

@* Saved message after saving the profile or the password (TempData["ProfileMessage"] set by the PageModel) *@
@if (TempData["ProfileMessage"] is string message)
{
    <div class="md-alert-success md-section" role="status"><i class="bi bi-check-circle me-2"></i>@message</div>
}

@* Errors from saving the profile (the password pop-up shows its own errors) *@
@if (reopenEdit)
{
    <div class="md-alert-danger md-section" role="alert">
        <strong>Please fix the following:</strong>
        <ul class="mb-0 mt-1 ps-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@* Personal information + Dining preferences are one form. They are read-only until Edit is clicked;
   the same button then turns into Save changes (green) and posts both cards to OnPostProfile. *@
<form method="post" asp-page-handler="Profile" id="profileForm" data-start-editing="@(reopenEdit ? "true" : "false")">
    <fieldset id="profileFields" class="md-profile-fields" disabled>
        <div class="row md-grid md-section">
            @* ---------- Personal information ---------- *@
            <div class="col-lg-6">
                <section class="md-card h-100">
                    <div class="md-card-header">
                        <span class="md-card-label">Personal information</span>
                        <span class="md-card-meta">Member since @Model.MemberSince</span>
                    </div>
                    <div class="md-card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="md-label" for="Customer_custName">Full name</label>
                                <input class="form-control md-input" id="Customer_custName" name="Customer.custName" type="text" autocomplete="name" maxlength="100" value="@Model.Input.custName" />
                            </div>
                            <div class="col-md-6">
                                <label class="md-label" for="Customer_custEmail">Email address</label>
                                <input class="form-control md-input" id="Customer_custEmail" name="Customer.custEmail" type="email" autocomplete="email" value="@Model.Input.custEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="md-label" for="Customer_custPhone">Phone number</label>
                                <input class="form-control md-input" id="Customer_custPhone" name="Customer.custPhone" type="tel" maxlength="11" inputmode="numeric" autocomplete="tel" value="@Model.Input.custPhone" />
                            </div>
                            @* Customer.custBirthday: can be added once; after that it is shown but can't be changed *@
                            <div class="col-md-6">
                                <label class="md-label" for="Customer_custBirthday">Birthday</label>
                                @if (Model.SavedBirthday.HasValue)
                                {
                                    <input class="form-control md-input" id="Customer_custBirthday" type="text" value="@Model.SavedBirthday.Value.ToString("d MMMM yyyy")" readonly tabindex="-1" />
                                    <div class="form-text">Used for birthday offers. Please ask our staff if it needs correcting.</div>
                                }
                                else
                                {
                                    <input class="form-control md-input" id="Customer_custBirthday" name="Customer.custBirthday" type="date" max="@MalaysiaClock.Today.ToString("yyyy-MM-dd")" value="@(Model.Input.custBirthday?.ToString("yyyy-MM-dd"))" />
                                    <div class="form-text">Optional, for birthday offers. It can't be changed once saved.</div>
                                }
                            </div>
                        </div>

                        @* Customer.promoOptIn *@
                        <div class="md-switch-row">
                            <div>
                                <label class="md-switch-title" for="Customer_promoOptIn">Receive promotions and member offers</label>
                                <span class="md-hint d-block mt-0">You can change this at any time.</span>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input md-switch" type="checkbox" role="switch" id="Customer_promoOptIn" name="Customer.promoOptIn" value="true" checked="@Model.Input.promoOptIn" />
                                @* Sends "false" when the switch is off (same as asp-for on a bool) *@
                                <input type="hidden" name="Customer.promoOptIn" value="false" />
                            </div>
                        </div>

                    </div>
                </section>
            </div>

            @* ---------- Dining preferences ---------- *@
            <div class="col-lg-6">
                <section class="md-card h-100">
                    <div class="md-card-header">
                        <span class="md-card-label">Dining preferences</span>
                    </div>
                    <div class="md-card-body">
                        @* Customer.Prefs (dish tags) and Customer.Allergies, same lists as the Register page *@
                        <div class="mb-3">
                            <span class="md-label">Dietary preferences</span>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var tag in RestaurantManagementSystem.Helpers.MenuVocabulary.Tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="pref_@(tag.Replace(" ", ""))" name="Customer.Prefs" value="@tag" checked="@Model.Input.Prefs.Contains(tag)" />
                                        <label class="form-check-label" for="pref_@(tag.Replace(" ", ""))">@tag</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <span class="md-label">Allergies</span>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var allergen in RestaurantManagementSystem.Helpers.MenuVocabulary.Allergens)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="allergy_@(allergen.Replace(" ", ""))" name="Customer.Allergies" value="@allergen" checked="@Model.Input.Allergies.Contains(allergen)" />
                                        <label class="form-check-label" for="allergy_@(allergen.Replace(" ", ""))">@allergen</label>
                                    </div>
                                }
                            </div>
                            <p class="md-hint mt-2 mb-0">We hide dishes that list these allergens from your recommendations. Please still tell our staff about any allergy.</p>
                        </div>

                        @* Customer.kitchenNotes – optional, max 300 characters *@
                        <div>
                            <label class="md-label" for="Customer_kitchenNotes">Other notes for the kitchen</label>
                            <input class="form-control md-input" id="Customer_kitchenNotes" name="Customer.kitchenNotes" type="text" maxlength="300" placeholder="e.g. no coriander" value="@Model.Input.kitchenNotes" />
                            <p class="md-hint mt-2 mb-0">Shared with restaurant staff only, to prepare your visit.</p>
                        </div>

                    </div>
                </section>
            </div>
        </div>
    </fieldset>

    @* Change password (opens the pop-up below) + Edit → Save changes, under the Dining preferences card *@
    <div class="md-profile-actions md-section">
        <button type="button" class="btn btn-md-dark" id="changePasswordButton" data-bs-toggle="modal" data-bs-target="#changePasswordPopup"><i class="bi bi-key me-2"></i>Change password</button>
        <button type="button" class="btn btn-md-dark" id="profileEditButton"><i class="bi bi-pencil me-2"></i>Edit</button>
    </div>
</form>

@* ---------- Change password pop-up ----------
   Posts to OnPostPassword. If the backend finds an error (e.g. wrong current password) it can add it to
   ModelState and return Page() – the pop-up then opens again by itself (see reopenPassword at the top). *@
<div class="modal fade md-popup" id="changePasswordPopup" tabindex="-1" aria-labelledby="changePasswordTitle" aria-hidden="true"
     data-auto-open="@(reopenPassword ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-page-handler="Password">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow">Account</span>
                    <h2 class="modal-title md-popup-title" id="changePasswordTitle">Change password</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* Backend error for the password form (ModelState) – hidden while there is none *@
                <div asp-validation-summary="ModelOnly" class="md-note-box md-note-box-danger md-password-errors mb-3"></div>
                <div class="mb-3">
                    <label class="md-label" for="currentPassword">Current password</label>
                    <div class="position-relative">
                        <input class="form-control md-input pe-5" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" />
                        <button type="button" class="md-eye-btn" data-toggle-password="currentPassword" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="md-label" for="newPassword">New password</label>
                    <div class="position-relative">
                        <input class="form-control md-input pe-5" id="newPassword" name="newPassword" type="password" autocomplete="new-password" />
                        <button type="button" class="md-eye-btn" data-toggle-password="newPassword" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button>
                    </div>
                    <p class="md-hint mt-2 mb-0">@Model.PasswordHint</p>
                </div>
                <div>
                    <label class="md-label" for="confirmPassword">Confirm new password</label>
                    <div class="position-relative">
                        <input class="form-control md-input pe-5" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" />
                        <button type="button" class="md-eye-btn" data-toggle-password="confirmPassword" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-md-green">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* function.js (shared, from the Register page): show / hide password eye buttons *@
    <script src="~/js/function.js" asp-append-version="true"></script>
    <script>
        // Change password pop-up: reopen it after a failed save (data-auto-open set by the page)
        (function () {
            var popup = document.getElementById('changePasswordPopup');
            if (popup.dataset.autoOpen === 'true') bootstrap.Modal.getOrCreateInstance(popup).show();
        })();

        // Edit → Save changes: first click unlocks the two cards, turns the button green and disables Change password;
        // the second click submits the form (OnPostProfile).
        (function () {
            var button = document.getElementById('profileEditButton');
            var fields = document.getElementById('profileFields');
            button.addEventListener('click', function (e) {
                if (!fields.disabled) return;                      // already editing → let it submit
                e.preventDefault();
                fields.disabled = false;
                document.getElementById('changePasswordButton').disabled = true;   // finish saving the profile first
                button.classList.replace('btn-md-dark', 'btn-md-green');
                button.innerHTML = '<i class="bi bi-check2 me-2"></i>Save changes';
                setTimeout(function () { button.type = 'submit'; }, 0);
                document.getElementById('Customer_custName').focus();
            });

            // After a failed save, open Edit mode again so the user can fix the fields
            if (document.getElementById('profileForm').dataset.startEditing === 'true') button.click();
        })();

    </script>
}