@page
@model RestaurantManagementSystem.Pages.Customer.EditReservationModel
@using RestaurantManagementSystem.Services
@{
    ViewData["Title"] = "Edit reservation";
    ViewData["ActiveNav"] = "Reservations";
    ViewData["Eyebrow"] = "Book a table";
    Layout = "_CustomerLayout";

    var r = Model.Booking;
    var settings = Model.Settings;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var code = "R-" + r.reservationID.ToString("D4");
    var status = r.reservationStatus;
    var area = r.DiningTable?.DiningArea?.areaName ?? "";
    var current = r.reservationDateTime.ToString("dddd, d MMMM yyyy · HH:mm", inv) + " · " + r.partySize
                  + (r.partySize == 1 ? " guest" : " guests") + " · " + r.DiningTable?.tableNumber + " " + area;
    var guestsText = Model.PartySize + (Model.PartySize == 1 ? " guest" : " guests");
    var fullCount = Model.AllSlots.Count(s => !Model.FreeSlots.Contains(s));
    var chips = new[] { "Window seat", "Quiet area", "High chair", "Wheelchair access" };

    ViewData["Heading"] = "Edit reservation " + code;
}

<div class="row md-grid md-section">
    @* ---------- Change form ---------- *@
    <div class="col-lg-7">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Change your booking</span>
                <span class="md-badge md-badge-@status.ToLowerInvariant()">@status</span>
            </div>
            <div class="md-card-body">
                <p class="md-res-item-note mb-3">Currently: @current</p>

                @* Changing party size or date reloads the page (?id=&partySize=&date=) so the times are recalculated *@
                <form method="post" id="editForm">
                    <input type="hidden" name="reservationId" value="@r.reservationID" />
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="md-label" for="partySize">Party size</label>
                            <select class="form-select md-input" id="partySize" name="partySize" data-reload>
                                @for (int n = settings.minPartySize; n <= settings.maxPartySize; n++)
                                {
                                    <option value="@n" selected="@(n == Model.PartySize)">@n @(n == 1 ? "guest" : "guests")</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationDate">Date</label>
                            <input class="form-control md-input" id="reservationDate" name="reservationDate" type="date" data-reload
                                   value="@Model.Date.ToString("yyyy-MM-dd", inv)"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd", inv)"
                                   max="@DateTime.Today.AddDays(settings.bookingWindowDays).ToString("yyyy-MM-dd", inv)" />
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationTime">Time</label>
                            @* Kept in sync with the Availability card on the right *@
                            <select class="form-select md-input" id="reservationTime" name="reservationTime">
                                <option value="" selected="@(Model.SelectedTime == null)">Choose a time</option>
                                @foreach (var slot in Model.AllSlots)
                                {
                                    var value = slot.ToString("HH:mm", inv);
                                    var free = Model.FreeSlots.Contains(slot);
                                    <option value="@value" disabled="@(!free)" selected="@(free && value == Model.SelectedTime)">@value@(free ? "" : " · full")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="md-label" for="specialRequest">Special request (optional)</label>
                        <textarea class="form-control md-input" id="specialRequest" name="specialRequest" rows="3"
                                  placeholder="Allergies, occasion, seating">@Model.SpecialRequest</textarea>
                        @* Same request chips as the Reservations page: add / remove common requests in the text *@
                        <div class="md-chips md-chips-ink">
                            @foreach (var chip in chips)
                            {
                                <button type="button" class="md-chip" data-chip="@chip" aria-pressed="false">@chip</button>
                            }
                        </div>
                    </div>

                    <p class="md-hint mb-3">
                        @(settings.autoConfirm
                            ? "Your table stays in the " + area + " area. A new time or party size is confirmed straight away when a table is free, "
                              + "unless the booking has a special request or is for " + ReservationService.LargePartySize + "+ guests – then our team confirms it."
                            : "Your table stays in the " + area + " area. Changing the date, time or party size sends the booking back to our team to confirm.")
                    </p>

                    @if (Model.ErrorMessage != null)
                    {
                        <p class="md-note-box md-note-box-danger mb-3" role="alert">@Model.ErrorMessage</p>
                    }

                    <div class="md-edit-actions">
                        <button type="submit" class="btn btn-md-green">Save changes</button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    @* ---------- Availability: click a time to pick it ---------- *@
    <div class="col-lg-5">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Availability</span>
                <ul class="md-slot-legend md-slot-legend-ink" aria-hidden="true">
                    <li><i class="is-available"></i>Available</li>
                    <li><i class="is-full"></i>Full</li>
                    <li><i class="is-selected"></i>Selected</li>
                </ul>
            </div>
            <div class="md-card-body">
                <p class="md-res-item-note mb-3">Times that fit @guestsText on @Model.Date.ToString("dddd d MMMM", inv), @area.</p>
                @* Same time selector as the Reservations page: grey box, dark selected slot, red "full" hint *@
                <div class="md-time-box">
                    @if (Model.AllSlots.Count == 0)
                    {
                        <p class="md-note-box md-note-box-danger mb-0">@(Model.Date == DateTime.Today ? "No more times can be booked online today." : "We're closed or not taking bookings on this date.") Please choose another date.</p>
                    }
                    else
                    {
                        <div class="md-slots md-slots-3 md-slots-ink" role="radiogroup" aria-label="Available times">
                            @foreach (var slot in Model.AllSlots)
                            {
                                var value = slot.ToString("HH:mm", inv);
                                var id = "avail" + value.Replace(":", "");
                                var free = Model.FreeSlots.Contains(slot);
                                <input type="radio" class="btn-check" name="availSlot" id="@id" value="@value" disabled="@(!free)" checked="@(free && value == Model.SelectedTime)" />
                                <label for="@id">@value</label>
                            }
                        </div>
                        @* Shown only when some slots are full *@
                        if (Model.FreeSlots.Count == 0)
                        {
                            <p class="md-note-box md-note-box-danger">No table in @area is free for @guestsText on this date. Try another date.</p>
                        }
                        else if (fullCount > 0)
                        {
                            <p class="md-note-box md-note-box-danger">Crossed-out times have no free table for @guestsText in @area. Please pick another time.</p>
                        }
                    }

                    @* Today only: explain why earlier times aren't listed (minimum notice, Admin > Settings) *@
                    @if (Model.Date == DateTime.Today)
                    {
                        <p class="md-hint mt-3 mb-0">Online bookings need at least @settings.minNoticeHours hours' notice.</p>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('editForm');
            var timeSelect = document.getElementById('reservationTime');

            // Party size / date changed: reload with the new choices so the server recalculates the free times
            form.addEventListener('change', function (e) {
                if (!e.target.hasAttribute('data-reload') || !e.target.value) return;
                var query = new URLSearchParams({
                    id: form.querySelector('[name="reservationId"]').value,
                    partySize: document.getElementById('partySize').value,
                    date: document.getElementById('reservationDate').value
                });
                window.location.search = query.toString();
            });

            // Availability grid → time dropdown
            document.querySelectorAll('input[name="availSlot"]').forEach(function (radio) {
                radio.addEventListener('change', function () { timeSelect.value = radio.value; });
            });

            // Time dropdown → availability grid
            timeSelect.addEventListener('change', function () {
                var radio = document.querySelector('input[name="availSlot"][value="' + timeSelect.value + '"]');
                if (radio) radio.checked = true;
            });

            // Request chips: add or remove the text in the Special request box (same as the Reservations page)
            var textarea = document.getElementById('specialRequest');
            document.querySelectorAll('.md-chip').forEach(function (chip) {
                var text = chip.dataset.chip;
                var on = textarea.value.split(' · ').map(function (p) { return p.trim(); }).indexOf(text) !== -1;
                chip.classList.toggle('active', on);
                chip.setAttribute('aria-pressed', on);
                chip.addEventListener('click', function () {
                    var parts = textarea.value.split(' · ').map(function (p) { return p.trim(); }).filter(Boolean);
                    var turnOn = !chip.classList.contains('active');
                    parts = parts.filter(function (p) { return p !== text; });
                    if (turnOn) parts.push(text);
                    textarea.value = parts.join(' · ');
                    chip.classList.toggle('active', turnOn);
                    chip.setAttribute('aria-pressed', turnOn);
                });
            });
        })();
    </script>
}
