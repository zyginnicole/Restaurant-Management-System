@page
@model RestaurantManagementSystem.Pages.Customer.EditReservationModel
@{
    ViewData["Title"] = "Edit reservation";
    ViewData["ActiveNav"] = "Reservations";
    ViewData["Eyebrow"] = "Book a table";
    Layout = "_CustomerLayout";

    // Example data – later from the Reservation being edited (OnGet(int id)) and the availability check.
    // The Reservations page links here with ?id=41 (Confirmed) or ?id=49 (Pending).
    var isPending = Request.Query["id"] == "49";
    var code = isPending ? "R-0049" : "R-0041";
    var status = isPending ? "Pending" : "Confirmed";
    var guests = isPending ? 8 : 2;
    var dateValue = isPending ? "2026-10-04" : "2026-09-20";
    var dateText = isPending ? "Sunday 4 October" : "Sunday 20 September";
    var area = isPending ? "VIP" : "Indoor";
    var current = isPending ? "Sunday, 4 October 2026 · 20:00 · 8 guests · VIP" : "Sunday, 20 September 2026 · 19:30 · 2 guests · T-07 Indoor";
    var request = isPending ? "Business dinner, private room if possible." : "Quiet table away from the entrance, if available.";
    var slots = new[] { "18:30", "18:45", "19:00", "19:15", "19:30", "19:45", "20:00", "20:15", "20:30" };
    var fullSlots = isPending ? new[] { "18:30", "19:30" } : new[] { "20:00", "20:15" };
    var currentSlot = isPending ? "20:00" : "19:30";
    var fullNote = isPending ? "18:30 and 19:30 are full for 8 guests in VIP. Nearest available: 18:45 or 19:45." : "20:00 and 20:15 are full for 2 guests Indoor. Nearest available: 19:45 or 20:30.";

    ViewData["Heading"] = "Edit reservation " + code;
}

<div class="row md-grid md-section">
    @* ---------- Change form ---------- *@
    <div class="col-lg-7">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Change your booking</span>
                <span class="md-badge md-badge-@status.ToLower()">@status</span>
            </div>
            <div class="md-card-body">
                <p class="md-res-item-note mb-3">Currently: @current</p>

                <form method="post" id="editForm">
                    <input type="hidden" name="reservationId" value="@(isPending ? 49 : 41)" />
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="md-label" for="partySize">Party size</label>
                            <select class="form-select md-input" id="partySize" name="partySize">
                                @for (int n = 1; n <= 20; n++)
                                {
                                    <option value="@n" selected="@(n == guests)">@n @(n == 1 ? "guest" : "guests")</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationDate">Date</label>
                            <input class="form-control md-input" id="reservationDate" name="reservationDate" type="date" value="@dateValue" min="2026-09-16" />
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationTime">Time</label>
                            @* Kept in sync with the Availability card on the right *@
                            <select class="form-select md-input" id="reservationTime" name="reservationTime">
                                @foreach (var slot in slots)
                                {
                                    <option value="@slot" disabled="@fullSlots.Contains(slot)" selected="@(slot == currentSlot)">@slot@(fullSlots.Contains(slot) ? " · full" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="md-label" for="specialRequest">Special request (optional)</label>
                        <textarea class="form-control md-input" id="specialRequest" name="specialRequest" rows="3"
                                  placeholder="Allergies, occasion, seating">@request</textarea>
                        @* Same request chips as the Reservations page: add / remove common requests in the text *@
                        <div class="md-chips md-chips-ink">
                            <button type="button" class="md-chip" data-chip="Window seat" aria-pressed="false">Window seat</button>
                            <button type="button" class="md-chip" data-chip="Quiet area" aria-pressed="false">Quiet area</button>
                            <button type="button" class="md-chip" data-chip="High chair" aria-pressed="false">High chair</button>
                            <button type="button" class="md-chip" data-chip="Wheelchair access" aria-pressed="false">Wheelchair access</button>
                        </div>
                    </div>

                    <p class="md-hint mb-3">Changing the date, time or party size sends the booking back to our team to confirm.</p>

                    <div class="md-edit-actions">
                        <button type="submit" class="btn btn-md-green">Save changes</button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    @* ---------- Availability: click a time to pick it ---------- *@
    <div class="col-lg-5">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Availability</span>
                <ul class="md-slot-legend md-slot-legend-ink" aria-hidden="true">
                    <li><i class="is-available"></i>Available</li>
                    <li><i class="is-full"></i>Full</li>
                    <li><i class="is-selected"></i>Selected</li>
                </ul>
            </div>
            <div class="md-card-body">
                <p class="md-res-item-note mb-3">Times that fit <span data-avail-guests>@guests guests</span> on <span data-avail-date>@dateText</span>, @area.</p>
                @* Same time selector as the Reservations page: grey box, dark selected slot, red "full" hint *@
                <div class="md-time-box">
                    <div class="md-slots md-slots-3 md-slots-ink" role="radiogroup" aria-label="Available times">
                        @foreach (var slot in slots)
                        {
                            var id = "avail" + slot.Replace(":", "");
                            <input type="radio" class="btn-check" name="availSlot" id="@id" value="@slot" disabled="@fullSlots.Contains(slot)" checked="@(slot == currentSlot)" />
                            <label for="@id">@slot</label>
                        }
                    </div>
                    @* Shown only when some slots are full – suggest the nearest free times *@
                    <p class="md-note-box md-note-box-danger">@fullNote</p>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var timeSelect = document.getElementById('reservationTime');

            // Availability grid → time dropdown
            document.querySelectorAll('input[name="availSlot"]').forEach(function (radio) {
                radio.addEventListener('change', function () { timeSelect.value = radio.value; });
            });

            // Time dropdown → availability grid
            timeSelect.addEventListener('change', function () {
                var radio = document.querySelector('input[name="availSlot"][value="' + timeSelect.value + '"]');
                if (radio) radio.checked = true;
            });

            // "Times that fit 2 guests on Sunday 20 September"
            function updateAvailabilityText() {
                var size = document.getElementById('partySize');
                document.querySelector('[data-avail-guests]').textContent = size.options[size.selectedIndex].text;
                var value = document.getElementById('reservationDate').value;
                if (value) {
                    document.querySelector('[data-avail-date]').textContent = new Date(value + 'T00:00:00')
                        .toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }).replace(',', '');
                }
            }
            // Request chips: add or remove the text in the Special request box (same as the Reservations page)
            var textarea = document.getElementById('specialRequest');
            document.querySelectorAll('.md-chip').forEach(function (chip) {
                var text = chip.dataset.chip;
                var on = textarea.value.split(' · ').map(function (p) { return p.trim(); }).indexOf(text) !== -1;
                chip.classList.toggle('active', on);
                chip.setAttribute('aria-pressed', on);
                chip.addEventListener('click', function () {
                    var parts = textarea.value.split(' · ').map(function (p) { return p.trim(); }).filter(Boolean);
                    var turnOn = !chip.classList.contains('active');
                    parts = parts.filter(function (p) { return p !== text; });
                    if (turnOn) parts.push(text);
                    textarea.value = parts.join(' · ');
                    chip.classList.toggle('active', turnOn);
                    chip.setAttribute('aria-pressed', turnOn);
                });
            });

            document.getElementById('partySize').addEventListener('change', updateAvailabilityText);
            document.getElementById('reservationDate').addEventListener('change', updateAvailabilityText);
        })();
    </script>
}
