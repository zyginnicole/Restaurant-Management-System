@page
@model RestaurantManagementSystem.Pages.Customer.DashboardModel
@{
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "Overview";
    ViewData["Eyebrow"] = "Good evening";
    ViewData["Heading"] = "Alexandra Beaumont";
    Layout = "_CustomerLayout";
}

@* Example data from the design. Replace with the signed-in customer's data later. *@

@* ---------- Recommendations hero ----------
   Same dishes as the Menu page's Recommendations tab. Replace .md-hero-photo's background
   with the dish photo (menuImageUrl) when real photos are ready. *@
<section id="recommendationHero" class="carousel slide md-hero md-section" data-bs-ride="carousel" data-bs-interval="6000" aria-label="Recommended dishes">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Based on your preferences · Mains</span>
                    <span class="md-hero-title">Wagyu Beef Tenderloin</span>
                    <span class="md-hero-price">RM 168.00</span>
                </span>
            </a>
        </div>
        <div class="carousel-item">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Based on your preferences · Mains</span>
                    <span class="md-hero-title">Pan-Seared Sea Bass</span>
                    <span class="md-hero-price">RM 98.00</span>
                </span>
            </a>
        </div>
        <div class="carousel-item">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Based on your preferences · Mains</span>
                    <span class="md-hero-title">Duck à l'Orange</span>
                    <span class="md-hero-price">RM 92.00</span>
                </span>
            </a>
        </div>
        <div class="carousel-item">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Popular selection · Desserts</span>
                    <span class="md-hero-title">Valrhona Chocolate Fondant</span>
                    <span class="md-hero-price">RM 36.00</span>
                </span>
            </a>
        </div>
        <div class="carousel-item">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Popular selection · Starters</span>
                    <span class="md-hero-title">Caviar &amp; Soft Egg</span>
                    <span class="md-hero-price">RM 85.00</span>
                </span>
            </a>
        </div>
        <div class="carousel-item">
            <a class="md-hero-slide" href="/Customer/Menu">
                <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                <span class="md-hero-content">
                    <span class="md-hero-eyebrow">Popular selection · Mains</span>
                    <span class="md-hero-title">Lobster Thermidor</span>
                    <span class="md-hero-price">RM 128.00 <span class="md-hero-soldout">Sold out today</span></span>
                </span>
            </a>
        </div>
    </div>

    @* Arrows (top-right) *@
    <div class="md-hero-arrows">
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide="prev" aria-label="Previous dish"><i class="bi bi-chevron-left"></i></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide="next" aria-label="Next dish"><i class="bi bi-chevron-right"></i></button>
    </div>

    @* Line indicators (bottom-right) *@
    <div class="carousel-indicators md-hero-indicators">
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Dish 1"></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="1" aria-label="Dish 2"></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="2" aria-label="Dish 3"></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="3" aria-label="Dish 4"></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="4" aria-label="Dish 5"></button>
        <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="5" aria-label="Dish 6"></button>
    </div>
</section>

<div class="row md-grid md-section">
    @* ---------- Next reservation (narrower column) ---------- *@
    <div class="col-lg-5">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Next reservation — <strong class="md-card-code">R-0041</strong></span>
                <span class="md-badge md-badge-confirmed">Confirmed</span>
            </div>
            <div class="md-card-body md-reservation">
                @* Date tile (month + day) and day/time *@
                <div class="md-res-datetime">
                    <div class="md-date-tile" aria-hidden="true">
                        <span class="md-date-tile-month">Sep</span>
                        <span class="md-date-tile-day">20</span>
                    </div>
                    <div>
                        <div class="md-res-date">Sunday evening</div>
                        <div class="md-res-time"><i class="bi bi-clock" aria-hidden="true"></i>7:30 PM</div>
                    </div>
                </div>

                @* Guests + table *@
                <div class="md-reservation-details">
                    <span><i class="bi bi-person" aria-hidden="true"></i>2 <span class="visually-hidden">guests</span></span>
                    <span>T-07 · Indoor</span>
                </div>
                @* View details opens the pop-up (Modify is available inside the pop-up) *@
                <div class="md-res-actions">
                    <button type="button" class="btn btn-md-outline" data-bs-toggle="modal" data-bs-target="#reservationModal">View details</button>
                </div>
            </div>
        </section>
    </div>

    @* ---------- Order in progress (wider column for the status line) ---------- *@
    <div class="col-lg-7">
        @* The whole card is clickable and opens the Orders page (stretched link below) *@
        <section class="md-card h-100 md-card-clickable">
            <a class="stretched-link" href="/Customer/Orders" aria-label="View order ORD-0088"></a>
            <div class="md-card-header">
                <span class="md-card-label">Order in progress — <strong class="md-card-code">ORD-0088</strong></span>
                <span class="md-badge md-badge-preparing">Preparing</span>
            </div>
            <div class="md-card-body">
                @* Order status flow: Order placed → Preparing → Served → Completed (or Cancelled).
                   Add "done" to finished steps and "current" to the active one. *@
                <ol class="md-tracker">
                    <li class="done"><span>Order placed</span></li>
                    <li class="current"><span>Preparing</span></li>
                    <li><span>Served</span></li>
                    <li><span>Completed</span></li>
                </ol>

                @* Ordered items: one row per OrderItem (quantity × name, line price) *@
                <ul class="md-order-items">
                    <li><span>1× Wagyu Beef Tenderloin</span><span>RM 168.00</span></li>
                    <li><span>1× Château Margaux 2018 (glass)</span><span>RM 120.00</span></li>
                </ul>
                <div class="md-order-summary">
                    <span>Total</span>
                    <span class="md-order-total">RM 288.00</span>
                </div>
            </div>
        </section>
    </div>
</div>

<partial name="_ReservationModal" />
