@page
@model RestaurantManagementSystem.Pages.Customer.DashboardModel
@using RestaurantManagementSystem.Helpers
@{
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "Overview";
    ViewData["Eyebrow"] = "Good evening";
    ViewData["Heading"] = HttpContext.Session.GetUserName() ?? "Welcome";

    // Next reservations card: the customer's Pending / Confirmed (incl. Seated) reservations in the next 7 days, soonest first.
    // Backend: replace this list with the query result. The card always has two slots:
    //   1 reservation → top slot filled, bottom slot left blank · 2 → both slots · 3 or more → the slots scroll inside the card.
    // UI preview only: /Customer/Dashboard?preview=2 or ?preview=3
    var nextReservations = new List<(string Code, string Status, string Month, string Day, string DayText, string Time, int Guests, string Table)>
    {
        ("R-0041", "Confirmed", "Sep", "20", "Sunday evening", "7:30 PM", 2, "T-07 · Indoor")
    };
    var preview = Request.Query["preview"].ToString();
    if (preview == "2" || preview == "3")
    {
        nextReservations.Insert(0, ("R-0047", "Seated", "Sep", "16", "Tonight", "7:00 PM", 3, "T-05 · Outdoor"));
    }
    if (preview == "3")
    {
        nextReservations.Add(("R-0049", "Pending", "Oct", "04", "Sunday evening", "8:00 PM", 8, "VIP"));
    }
}

@* Example data from the design. Replace with the signed-in customer's data later. *@

@* ---------- Recommendations hero ----------
