@page
@model RestaurantManagementSystem.Pages.Customer.DashboardModel
@using RestaurantManagementSystem.Helpers
@{
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "Overview";
    ViewData["Eyebrow"] = "Good evening";
    ViewData["Heading"] = HttpContext.Session.GetUserName() ?? "Welcome";
    Layout = "_CustomerLayout";

    // Next reservations card: the customer's Pending / Confirmed (incl. Seated) reservations in the next 7 days, soonest first.
    // Backend: replace this list with the query result. The card always has two slots:
    //   1 reservation → top slot filled, bottom slot left blank · 2 → both slots · 3 or more → the slots scroll inside the card.
    // UI preview only: /Customer/Dashboard?preview=2 or ?preview=3
    var nextReservations = new List<(string Code, string Status, string Month, string Day, string DayText, string Time, int Guests, string Table)>
    {
        ("R-0041", "Confirmed", "Sep", "20", "Sunday evening", "7:30 PM", 2, "T-07 · Indoor")
    };
    var preview = Request.Query["preview"].ToString();
    if (preview == "2" || preview == "3")
    {
        nextReservations.Insert(0, ("R-0047", "Seated", "Sep", "16", "Tonight", "7:00 PM", 3, "T-05 · Outdoor"));
    }
    if (preview == "3")
    {
        nextReservations.Add(("R-0049", "Pending", "Oct", "04", "Sunday evening", "8:00 PM", 8, "VIP"));
    }
}

@* Example data from the design. Replace with the signed-in customer's data later. *@

@* ---------- Recommendations hero ----------
   Same dishes as the Menu page's Recommendations tab (RecommendationService.ToHeroSlides).
   Hidden when there is nothing to recommend. *@
@if (Model.HeroSlides.Count > 0)
{
    <section id="recommendationHero" class="carousel slide md-hero md-section" data-bs-ride="carousel" data-bs-interval="6000" aria-label="Recommended dishes">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.HeroSlides.Count; i++)
            {
                var slide = Model.HeroSlides[i];
                var eyebrow = slide.Category == "" ? slide.Label : slide.Label + " · " + slide.Category;
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <a class="md-hero-slide" href="/Customer/Menu">
                        @if (!string.IsNullOrWhiteSpace(slide.ImageUrl))
                        {
                            <span class="md-hero-photo" aria-hidden="true" style="background-image:url('@slide.ImageUrl'); background-size:cover; background-position:center;"></span>
                        }
                        else
                        {
                            <span class="md-hero-photo" aria-hidden="true">Dish photo</span>
                        }
                        <span class="md-hero-content">
                            <span class="md-hero-eyebrow">@eyebrow</span>
                            <span class="md-hero-title">@slide.Name</span>
                            <span class="md-hero-price">RM @slide.Price.ToString("0.00")</span>
                        </span>
                    </a>
                </div>
            }
        </div>

        @if (Model.HeroSlides.Count > 1)
        {
            @* Arrows (top-right) *@
            <div class="md-hero-arrows">
                <button type="button" data-bs-target="#recommendationHero" data-bs-slide="prev" aria-label="Previous dish"><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-bs-target="#recommendationHero" data-bs-slide="next" aria-label="Next dish"><i class="bi bi-chevron-right"></i></button>
            </div>

            @* Line indicators (bottom-right) *@
            <div class="carousel-indicators md-hero-indicators">
                @for (int i = 0; i < Model.HeroSlides.Count; i++)
                {
                    <button type="button" data-bs-target="#recommendationHero" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Dish @(i + 1)"></button>
                }
            </div>
        }
    </section>
}

<div class="row md-grid md-section">
    @* ---------- Next reservation (narrower column) ---------- *@
    <div class="col-lg-5">
        @* Each reservation links to the Reservations page with its details pop-up open
           (?view= the reservation code – the Reservations page opens the matching row). *@
        @if (nextReservations.Count > 0)
        {
            var first = nextReservations[0];
            @* Two slots, each the same layout (big date tile + day, time, guests, table).
               Header shows the soonest reservation; later slots show their own code + status.
               1 reservation → bottom slot left blank · 3+ → the slots scroll inside the card. *@
            <section class="md-card h-100">
                <div class="md-card-header">
                    <span class="md-card-label">Next reservation — <strong class="md-card-code">@first.Code</strong></span>
                </div>
                <ul class="md-next-slots" tabindex="0" aria-label="Reservations in the next 7 days">
                    @for (int i = 0; i < nextReservations.Count; i++)
                    {
                        var r = nextReservations[i];
                        <li class="md-next-slot md-row-link">
                            <a class="stretched-link" href="/Customer/Reservations?view=@r.Code" aria-label="View reservation @r.Code"></a>
                            <div class="md-next-res">
                                <div class="md-date-tile md-date-tile-lg" aria-hidden="true">
                                    <span class="md-date-tile-month">@r.Month</span>
                                    <span class="md-date-tile-day">@r.Day</span>
                                </div>
                                <div class="md-next-res-info">
                                    @* Status tag above the day (the code too from the 2nd slot – the header names the first) *@
                                    <span class="md-next-slot-code">
                                        <span class="md-badge md-badge-@r.Status.ToLower()">@r.Status</span>
                                        @if (i > 0)
                                        {
                                            <span class="md-res-code">@r.Code</span>
                                        }
                                    </span>
                                    <div class="md-res-date">@r.DayText</div>
                                    <div class="md-next-res-row">
                                        <span class="md-res-time"><i class="bi bi-clock" aria-hidden="true"></i>@r.Time</span>
                                        <span><i class="bi bi-person" aria-hidden="true"></i>@r.Guests <span class="visually-hidden">guests</span></span>
                                    </div>
                                    <div class="md-next-res-row">
                                        <span><i class="bi bi-lamp md-lamp" aria-hidden="true"></i>@r.Table</span>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                    @if (nextReservations.Count == 1)
                    {
                        @* Blank bottom slot keeps the two-slot layout *@
                        <li class="md-next-slot is-empty" aria-hidden="true"></li>
                    }
                </ul>
            </section>
        }
    </div>

    @* ---------- Order in progress (wider column for the status line) ---------- *@
    <div class="col-lg-7">
        @* The whole card is clickable and opens the Orders page (stretched link below).
           Shows the customer's latest open order (see DashboardModel); no open order → empty state. *@
        @if (Model.OrderInProgress == null)
        {
            <section class="md-card h-100">
                <div class="md-card-header">
                    <span class="md-card-label">Order in progress</span>
                </div>
                <div class="md-card-body text-center py-4">
                    <p class="md-hint mb-3">You have no active orders right now.</p>
                    <a class="btn btn-md-dark" href="/Customer/Menu">Browse the menu</a>
                </div>
            </section>
        }
        else
        {
            var order = Model.OrderInProgress;

            // Order placed → Preparing → Served → Completed ("done" = finished, "current" = now)
            bool stepPreparing = order.Status == "Preparing" || order.Status == "Served" || order.Status == "Completed";
            bool stepServed = order.Status == "Served" || order.Status == "Completed";
            bool stepCompleted = order.Status == "Completed";
            string orderBadge = order.Status switch
            {
                "Order placed" => "md-badge-placed",
                "Preparing" => "md-badge-preparing",
                "Served" => "md-badge-served",
                _ => "md-badge-completed"
            };

            <section class="md-card h-100 md-card-clickable">
                <a class="stretched-link" href="/Customer/Orders" aria-label="View order @order.OrderCode"></a>
                <div class="md-card-header">
                    <span class="md-card-label">Order in progress — <strong class="md-card-code">@order.OrderCode</strong></span>
                    <span class="md-badge @orderBadge">@order.Status</span>
                </div>
                <div class="md-card-body">
                    <ol class="md-tracker">
                        <li class="@(order.Status == "Order placed" ? "current" : "done")"><span>Order placed</span></li>
                        <li class="@(order.Status == "Preparing" ? "current" : (stepPreparing ? "done" : ""))"><span>Preparing</span></li>
                        <li class="@(order.Status == "Served" ? "current" : (stepServed ? "done" : ""))"><span>Served</span></li>
                        <li class="@(order.Status == "Completed" ? "current" : (stepCompleted ? "done" : ""))"><span>Completed</span></li>
                    </ol>

                    @* One row per OrderItem (quantity × name, line price) *@
                    <ul class="md-order-items">
                        @foreach (var item in order.Items)
                        {
                            <li><span>@item.Quantity&times; @item.Name</span><span>RM @item.LineTotal.ToString("N2")</span></li>
                        }
                    </ul>
                    <div class="md-order-summary">
                        <span>Total</span>
                        <span class="md-order-total">RM @order.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </section>
        }
    </div>
</div>