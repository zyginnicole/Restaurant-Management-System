@page
@model RestaurantManagementSystem.Pages.Customer.PaymentSuccessModel
@{
    // Example receipts – backend: build one ReceiptView from the paid Order (see Pages/Shared/Partials/ReceiptView.cs).
    // Takeaway is the normal case here (paid online). ?type=dinein is a UI preview of the dine-in receipt
    // (dine-in bills are paid at the table – staff can show the same _Receipt partial).
    bool dineIn = Request.Query["type"] == "dinein";

    var receipt = dineIn
        ? new ReceiptView
        {
            ReceiptNo = "RCP-0079", OrderCode = "ORD-0079", IsDineIn = true,
            ReservationCode = "R-0038", TableCode = "T-12",
            CustomerName = "Alexandra Beaumont",
            Items = new()
            {
                new() { Quantity = 2, Name = "Oyster Selection", UnitPrice = 68m },
                new() { Quantity = 1, Name = "Wagyu Beef Tenderloin", UnitPrice = 168m, Note = "Medium rare" },
                new() { Quantity = 1, Name = "Duck à l'Orange", UnitPrice = 92m },
                new() { Quantity = 3, Name = "Mille-Feuille", UnitPrice = 32m }
            },
            PaymentMethod = "Card", PaymentStatus = "Paid",
            PaidAt = new DateTimeOffset(2026, 8, 15, 21, 38, 0, TimeSpan.FromHours(8))
        }
        : new ReceiptView
        {
            ReceiptNo = "RCP-0089", OrderCode = "ORD-0089", IsDineIn = false,
            PickupTime = "21:30",
            CustomerName = "Alexandra Beaumont",
            Items = new()
            {
                new() { Quantity = 1, Name = "Wagyu Beef Tenderloin", UnitPrice = 168m },
                new() { Quantity = 1, Name = "Valrhona Chocolate Fondant", UnitPrice = 36m }
            },
            PaymentMethod = "Card", PaymentStatus = "Paid",
            PaidAt = new DateTimeOffset(2026, 9, 16, 20, 44, 0, TimeSpan.FromHours(8))
        };

    ViewData["Title"] = "Payment successful";
    ViewData["ActiveNav"] = "Orders";
    ViewData["Eyebrow"] = "Payment successful";
    ViewData["Heading"] = "Thank you, Alexandra";
    ViewData["Subtitle"] = $"Your payment of RM {receipt.Total:#,##0.00} was received.";
    Layout = "_CustomerLayout";
}

<div class="row md-grid md-section">
    @* ---------- Receipt (shared _Receipt partial) ---------- *@
    <div class="col-lg-6">
        <section class="md-card h-100">
            <div class="md-card-header">
                <span class="md-card-label">Receipt</span>
                <span class="md-badge md-badge-paid">Paid</span>
            </div>
            <div class="md-card-body">
                <partial name="~/Pages/Shared/Partials/_Receipt.cshtml" model="receipt" />
                <div class="md-receipt-actions">
                    @* Downloads only the receipt paper as a PDF (wwwroot/js/pdf-download.js) – file name from the receipt no. *@
                    <button type="button" class="btn btn-md-dark" data-pdf-target="#receiptPaper" data-pdf-name="MaisonDoree-Receipt-@receipt.ReceiptNo"><i class="bi bi-download me-2"></i>Download receipt (PDF)</button>
                    <a class="btn btn-md-outline" href="/Customer/History">View in History</a>
                </div>
            </div>
        </section>
    </div>

    @* ---------- Track order ---------- *@
    <div class="col-lg-6">
        <section class="md-card h-100 md-card-clickable">
            <a class="stretched-link" href="/Customer/Orders" aria-label="Track order @receipt.OrderCode on the Orders page"></a>
            <div class="md-card-header">
                <span class="md-card-label">Track order — <strong class="md-card-code">@receipt.OrderCode</strong></span>
                @if (dineIn)
                {
                    <span class="md-badge md-badge-completed">Completed</span>
                }
                else
                {
                    <span class="md-badge md-badge-preparing">Preparing</span>
                }
            </div>
            <div class="md-card-body">
                @if (dineIn)
                {
                    @* Dine-in: the bill is paid after everything is served, so the order is complete *@
                    <ol class="md-tracker">
                        <li class="done"><span>Order placed</span><small class="md-tracker-time">20:12</small></li>
                        <li class="done"><span>Preparing</span><small class="md-tracker-time">20:14</small></li>
                        <li class="done"><span>Served</span><small class="md-tracker-time">21:05</small></li>
                        <li class="current"><span>Completed</span><small class="md-tracker-time">21:38</small></li>
                    </ol>
                    <p class="mb-2">Your bill for table <b>T-12</b> is settled. We hope you enjoyed your evening.</p>
                    <p class="md-hint mb-0">You can rate this visit from your History page.</p>
                }
                else
                {
                    <ol class="md-tracker">
                        <li class="done"><span>Order placed</span><small class="md-tracker-time">20:44</small></li>
                        <li class="current"><span>Preparing</span><small class="md-tracker-time">20:46</small></li>
                        <li><span>Served</span><small class="md-tracker-time">—</small></li>
                        <li><span>Completed</span><small class="md-tracker-time">—</small></li>
                    </ol>
                    <p class="mb-2">The kitchen is preparing your order. Estimated ready time <b>21:25</b>, for pick-up at 21:30.</p>
                    <p class="md-hint mb-0">You'll get a notification when it's ready. Open the Orders page to follow it.</p>
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-download.js" asp-append-version="true"></script>
}
