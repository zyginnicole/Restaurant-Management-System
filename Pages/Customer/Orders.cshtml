@page
@model RestaurantManagementSystem.Pages.Customer.OrdersModel
@{
    ViewData["Title"] = "Orders";
    ViewData["ActiveNav"] = "Orders";
    ViewData["Eyebrow"] = "Your orders";
    ViewData["Heading"] = "Orders";
    ViewData["Subtitle"] = "Follow your open orders from the kitchen to your table.";
    Layout = "_CustomerLayout";
}

@* Example data from the design. Replace with the customer's open orders later.
   Order colours (same scheme as every module): Order placed yellow · Preparing orange · Served blue · Completed green.
   Only open orders appear here; Completed and Cancelled ones are on the History page. *@

@* Same cart button as the Menu page: shows the current cart and opens Checkout *@
@section HeaderActions {
    <a class="btn btn-md-dark md-cart-btn" href="/Customer/Checkout">
        <i class="bi bi-bag"></i>
        Cart
    </a>
}

@* Message after cancelling an order (TempData["OrderMessage"] set by OnPostCancel) *@
@if (TempData["OrderMessage"] is string orderMessage)
{
    <div class="md-note-box md-note-box-info md-section" role="status">@orderMessage</div>
}

@* What this page was built from; customer-orders-refresh.js compares it with the live status and reloads when it changes *@
<div id="ordersWatch" class="d-none" data-snapshot="@(string.Join(",", Model.OpenOrders.Select(o => o.OrderCode + ":" + o.Status + ":" + (o.PaymentStatus == "Paid" ? "1" : "0")).OrderBy(x => x, StringComparer.Ordinal)))"></div>

@if (Model.OpenOrders.Count == 0)
{
    <div class="md-card md-section text-center py-5">
        <p class="md-hint mb-3">You have no active orders right now.</p>
        <div>
            <a class="btn btn-md-dark" href="/Customer/Menu">Browse the menu</a>
            <a class="btn btn-md-outline ms-2" href="/Customer/History">View past orders</a>
        </div>
    </div>
}
else
{
    <div class="row md-grid md-section">
        @* ---------- Selected order: tracker, items and totals ----------
           One detail section per open order; the list on the right switches which one is shown.
           On phones the list comes first (order-1) and the detail below it (order-2). *@
        <div class="col-lg-7 order-2 order-lg-1">
            @for (int i = 0; i < Model.OpenOrders.Count; i++)
            {
                var o = Model.OpenOrders[i];
                string badgeClass = o.Status switch
                {
                    "Order placed" => "md-badge-placed",
                    "Preparing" => "md-badge-preparing",
                    "Served" => "md-badge-served",
                    _ => "md-badge-completed"
                };

                bool stepPreparing = o.Status == "Preparing" || o.Status == "Served" || o.Status == "Completed";
                bool stepServed = o.Status == "Served" || o.Status == "Completed";
                bool stepCompleted = o.Status == "Completed";

                <section class="md-card h-100 md-order-detail @(i > 0 ? "d-none" : "")" id="order-@o.OrderCode">
                    <div class="md-card-header">
                        <span class="md-card-label">Order — <strong class="md-card-code">@o.OrderCode</strong></span>
                        <span class="md-badge @badgeClass">@o.Status</span>
                    </div>
                    <div class="md-card-body">
                        @* Order placed → Preparing → Served → Completed; "done" = finished, "current" = now *@
                        <ol class="md-tracker">
                            <li class="@(o.Status == "Order placed" ? "current" : "done")">
                                <span>Order placed</span><small class="md-tracker-time">@o.OrderDateTime.ToString("HH:mm")</small>
                            </li>
                            <li class="@(o.Status == "Preparing" ? "current" : (stepPreparing ? "done" : ""))">
                                <span>Preparing</span><small class="md-tracker-time">—</small>
                            </li>
                            <li class="@(o.Status == "Served" ? "current" : (stepServed ? "done" : ""))">
                                <span>Served</span><small class="md-tracker-time">—</small>
                            </li>
                            <li class="@(o.Status == "Completed" ? "current" : (stepCompleted ? "done" : ""))">
                                <span>Completed</span><small class="md-tracker-time">—</small>
                            </li>
                        </ol>

                        <dl class="md-order-facts">
                            <div><dt>Order type</dt><dd>@(o.IsDineIn ? "Dine-in" : "Takeaway")</dd></div>
                            @if (o.IsDineIn)
                            {
                                <div><dt>Table</dt><dd><i class="bi bi-lamp md-lamp" aria-hidden="true"></i>@o.TableNumber · @o.AreaName</dd></div>
                                if (!string.IsNullOrEmpty(o.ReservationCode))
                                {
                                    <div><dt>Reservation</dt><dd>@o.ReservationCode</dd></div>
                                }
                            }
                            else
                            {
                                <div><dt>Pick-up</dt><dd>@(o.PickupDateTime?.ToString("d MMM, HH:mm") ?? "Asap")</dd></div>
                            }
                            <div><dt>Payment</dt><dd><span class="md-badge @(o.PaymentStatus == "Paid" ? "md-badge-paid" : "md-badge-pending")">@o.PaymentStatus</span></dd></div>
                            <div><dt>Placed</dt><dd>@o.OrderDateTime.ToString("d MMM, HH:mm")</dd></div>
                        </dl>

                        @* One row per OrderItem: quantity × name, kitchen note, line price *@
                        <ul class="md-order-items">
                            @foreach (var item in o.Items)
                            {
                                <li>
                                    <span>
                                        @item.Quantity&times; @item.Name
                                        @if (!string.IsNullOrEmpty(item.Note))
                                        {
                                            <small class="md-item-note">@item.Note</small>
                                        }
                                    </span>
                                    <span>RM @item.LineTotal.ToString("N2")</span>
                                </li>
                            }
                        </ul>
                        <div class="md-order-summary">
                            <span>Total @(o.PaymentStatus == "Paid" ? "paid" : "so far")</span>
                            <span class="md-order-total">RM @o.TotalAmount.ToString("N2")</span>
                        </div>

                        @* Dine-in: one bill for every unpaid order at this table, payable once ALL of them are served.
                           Takeaway: pay straight after checkout. *@
                        @if (o.CanPay)
                        {
                            <div class="mt-4 pt-3 border-top text-end">
                                @if (o.IsDineIn && o.BillOrderCount > 1)
                                {
                                    <p class="md-hint text-start mb-2">One bill for table @o.TableNumber: @o.BillOrderCodes</p>
                                }
                                <a class="btn btn-md-green w-100" href="@o.PayUrl">Pay bill now (RM @o.BillTotal.ToString("N2"))</a>
                            </div>
                        }
                        else if (o.IsDineIn && o.PaymentStatus != "Paid")
                        {
                            <p class="md-note-box mt-3 mb-0">@(o.Status == "Served"
                                ? $"This order has been served. The bill for table {o.TableNumber} opens once the other {o.WaitingOrders} order(s) at this table are served."
                                : "The kitchen is preparing your order. Service charge and SST are added to the bill, which can be paid once everything at your table is served.")</p>
                        }
                        else if (!o.IsDineIn)
                        {
                            @* Takeaway: short status note (keeps the card from looking empty when there are few items) *@
                            string sstText = Model.SstPct.ToString("0.##");
                            <p class="md-note-box mt-3 mb-0">@(o.Status == "Order placed"
                                ? $"{sstText}% SST is added to your bill. The kitchen will start preparing your order soon. Thank you for waiting!"
                                : o.Status == "Preparing"
                                    ? $"{sstText}% SST is added to your bill. The kitchen is preparing your order. Thank you for waiting!"
                                    : "Your order is ready. Please collect it at the counter at your pick-up time. Thank you!")</p>
                        }

                        @* Cancel only while orderStatus = "Order placed" (before the kitchen starts) *@
                        @if (o.CanCancel)
                        {
                            <div class="md-order-cancel mt-3">
                                <p class="md-hint mb-0">You can cancel until the kitchen starts preparing. Paid orders are refunded to your card.</p>
                                <button type="button" class="btn md-btn-cancel md-btn-sm" data-bs-toggle="modal" data-bs-target="#cancelOrderPopup"
                                        data-id="@o.OrderId" data-code="@o.OrderCode" data-details="@(o.IsDineIn ? "Dine-in" : "Takeaway") · RM @o.TotalAmount.ToString("N2")">
                                    Cancel order
                                </button>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        @* ---------- Open orders list (click to show the order on the left) ---------- *@
        <div class="col-lg-5 order-1 order-lg-2">
            <section class="md-card h-100">
                <div class="md-card-header">
                    <span class="md-card-label">Your open orders</span>
                    <span class="md-card-meta">@Model.OpenOrders.Count open</span>
                </div>
                <ul class="md-order-pick" id="orderPick">
                    @for (int i = 0; i < Model.OpenOrders.Count; i++)
                    {
                        var o = Model.OpenOrders[i];
                        string rowStatusClass = o.Status switch
                        {
                            "Order placed" => "is-placed",
                            "Preparing" => "is-preparing",
                            "Served" => "is-served",
                            _ => ""
                        };
                        string badgeClass = o.Status switch
                        {
                            "Order placed" => "md-badge-placed",
                            "Preparing" => "md-badge-preparing",
                            "Served" => "md-badge-served",
                            _ => "md-badge-completed"
                        };

                        <li>
                            <button type="button" class="md-order-pick-row @rowStatusClass @(i == 0 ? "active" : "")" data-show="order-@o.OrderCode" aria-pressed="@(i == 0 ? "true" : "false")">
                                <span class="md-order-pick-main">
                                    <span class="md-res-code">@o.OrderCode</span>
                                    <span class="md-res-item-info">
                                        @if (o.IsDineIn)
                                        {
                                            @:Dine-in · <i class="bi bi-lamp md-lamp" aria-hidden="true"></i>@o.TableNumber · @o.Items.Sum(x => x.Quantity) items
                                        }
                                        else
                                        {
                                            @:Takeaway · pick-up @(o.PickupDateTime?.ToString("HH:mm") ?? "ASAP") · @o.Items.Sum(x => x.Quantity) items
                                        }
                                    </span>
                                    <span class="md-res-item-note">Placed @o.OrderDateTime.ToString("HH:mm")@(o.IsDineIn && o.PaymentStatus != "Paid" ? " · Unpaid Bill" : "")</span>
                                </span>
                                <span class="md-order-pick-side">
                                    <span class="md-badge @badgeClass">@o.Status</span>
                                    <span class="md-order-pick-amount">RM @o.TotalAmount.ToString("N2")</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                <div class="md-card-foot">
                    <a class="md-stat-action" href="/Customer/History">Past orders are in History <i class="bi bi-arrow-right"></i></a>
                </div>
            </section>
        </div>
    </div>
}

@* ---------- Cancel order pop-up (only for Order placed) ----------
   Shared _ConfirmPopup: posts orderId (from the button's data-id) to OnPostCancel.
   {code} and {details} come from the clicked button's data-code / data-details. *@
@{
    var cancelOrderPopup = new ConfirmPopupView
    {
        Id = "cancelOrderPopup", Eyebrow = "Order", Title = "Cancel {code}?", Message = "{details}",
        Note = "Its status changes to Cancelled and the payment is refunded to your card within 3–5 working days.",
        Handler = "Cancel", IdField = "orderId",
        BackText = "Keep order", ConfirmText = "Cancel order", Danger = true
    };
}
<partial name="~/Pages/Shared/Popups/_ConfirmPopup.cshtml" model="cancelOrderPopup" />

@section Scripts {
    <script>
        (function () {
            // Open orders list: show the chosen order on the left
            var rows = document.querySelectorAll('#orderPick [data-show]');
            var storeKey = 'custOrderSelected';

            function select(row, scroll) {
                rows.forEach(function (r) {
                    var on = r === row;
                    r.classList.toggle('active', on);
                    r.setAttribute('aria-pressed', on);
                    var panel = document.getElementById(r.dataset.show);
                    if (panel) panel.classList.toggle('d-none', !on);
                });
                try { sessionStorage.setItem(storeKey, row.dataset.show); } catch (e) { }
                // On phones the detail is below the list – scroll down to it
                if (scroll && window.innerWidth < 992) {
                    var activePanel = document.getElementById(row.dataset.show);
                    if (activePanel) activePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
            rows.forEach(function (row) {
                row.addEventListener('click', function () { select(row, true); });
            });

            // After the automatic refresh, show the order that was selected before (if it is still open)
            try {
                var saved = sessionStorage.getItem(storeKey);
                var savedRow = saved && document.querySelector('#orderPick [data-show="' + saved + '"]');
                if (savedRow) select(savedRow, false);
            } catch (e) { }
            // The Cancel order pop-up is filled by confirm-popup.js (loaded by the layout)
        })();
    </script>
    @* Reloads the page when one of the customer's orders changes (status, payment, new or finished order) *@
    <script src="~/js/customer-orders-refresh.js" asp-append-version="true"></script>
}
