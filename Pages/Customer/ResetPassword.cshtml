@page
@model RestaurantManagementSystem.Pages.Customer.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_CustomerAuthLayout";
}

@* Bootstrap Icons (eye icon for show / hide password) *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<h1>Reset password</h1>
<p class="md-auth-subtitle">Enter the code sent to <strong>@Model.Email</strong> and choose a new password</p>

@if (!string.IsNullOrEmpty(Model.InfoMessage))
{
    <div class="md-alert-success mb-4" role="status">@Model.InfoMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="md-alert-danger mb-4" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <input type="hidden" asp-for="Email" />

    <div class="mb-3">
        <label class="md-label" asp-for="Code">6-digit code</label>
        <input class="form-control md-input" asp-for="Code" inputmode="numeric" maxlength="6"
               pattern="[0-9]{6}" placeholder="123456" autocomplete="one-time-code" required autofocus />
    </div>

    <div class="mb-3">
        <label class="md-label" asp-for="NewPassword">New password</label>
        <div class="position-relative">
            <input class="form-control md-input pe-5" asp-for="NewPassword" type="password"
                   placeholder="••••••••" autocomplete="new-password" required />
            <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                    style="right: .75rem; line-height: 1; font-size: 1rem;"
                    data-toggle-password="NewPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <p class="md-hint">@Model.PasswordHint</p>
    </div>

    <div class="mb-4">
        <label class="md-label" asp-for="ConfirmPassword">Confirm new password</label>
        <div class="position-relative">
            <input class="form-control md-input pe-5" asp-for="ConfirmPassword" type="password"
                   placeholder="••••••••" autocomplete="new-password" required />
            <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                    style="right: .75rem; line-height: 1; font-size: 1rem;"
                    data-toggle-password="ConfirmPassword" aria-label="Show password" aria-pressed="false">
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>

    <button type="submit" class="btn btn-md-dark w-100">Reset password</button>

    @* formnovalidate: the Resend button works even when the boxes above are empty *@
    <p class="md-auth-switch">
        Didn't get it? Check your Spam folder, or
        <button type="submit" asp-page-handler="Resend" formnovalidate class="btn btn-link p-0 align-baseline"
                style="color: var(--md-ink); font-size: inherit;">
            send a new code
        </button>
    </p>
</form>

<p class="md-auth-switch"><a asp-page="/Customer/Login">Back to sign in</a></p>

<script src="~/js/function.js" asp-append-version="true"></script>