@using Microsoft.EntityFrameworkCore
@inject RestaurantManagementSystem.Data.ApplicationDbContext Db
@{
    // Default layout. Each module overrides this at the top of its own pages.
    Layout = "_CustomerLayout";

    // Restaurant name and tagline come from Admin > Settings (database).
    var settings = await Db.SystemSettings.AsNoTracking().FirstOrDefaultAsync();
    ViewData["Brand"] = settings?.restaurantName ?? "Maison Laurent";
    ViewData["BrandTagline"] = settings?.tagline ?? "";
}