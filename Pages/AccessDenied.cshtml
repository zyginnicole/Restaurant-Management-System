@page
@model RestaurantManagementSystem.Pages.AccessDeniedModel
@{
    // Same design as the Error page (Layout = null)
    ViewData["Title"] = "Access denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @ViewData["Brand"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="md-error">
        <div class="md-error-card">
            <span class="md-eyebrow">@ViewData["Brand"]</span>
            <h1>Access denied</h1>
            <p>You are signed in as @Model.RoleText, and this page belongs to another part of the system. If you need it, sign out and sign in with the right account.</p>

            <div class="md-error-actions">
                <a class="btn btn-md-outline" href="@Model.HomePage">Go to my dashboard</a>
                @* Sign out posts to /Logout (with the antiforgery token), like the sign-out pop-ups *@
                <form method="post" asp-page="/Logout" class="d-inline">
                    <button type="submit" class="btn btn-md-dark">Sign out</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>