@model RestaurantManagementSystem.Pages.Shared.Partials.ReceiptView
@*
    Shared receipt (till-receipt style) for dine-in and takeaway.
    Usage: <partial name="~/Pages/Shared/Partials/_Receipt.cshtml" model="receipt" />   (receipt = ReceiptView, see ReceiptView.cs)
    Dine-in shows the reservation + table and adds the 10% service charge; takeaway shows the pick-up time.
    id="receiptPaper" is what the "Download receipt (PDF)" button saves.
*@
@{
    string Rm(decimal value) => value.ToString("#,##0.00");
}
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Abel&display=swap" rel="stylesheet" />

<div class="md-receipt" id="receiptPaper">
    @* Restaurant details – fixed text (no restaurant table in the database) *@
    <div class="md-receipt-head">
        <div class="md-receipt-brand">@ViewData["Brand"]</div>
        <div>Fine dining · Est. 1998</div>
        <div>12 Jalan Bukit Bintang, Kuala Lumpur</div>
        <div>www.maisondoree.com</div>
    </div>

    <hr class="md-receipt-line" />

    <div class="md-receipt-row"><span class="md-receipt-label">Receipt no.</span><span>@Model.ReceiptNo</span></div>
    <div class="md-receipt-row"><span class="md-receipt-label">Order</span><span>@Model.OrderCode · @(Model.IsDineIn ? "Dine-in" : "Takeaway")</span></div>
    @if (Model.IsDineIn && Model.ReservationCode != null)
    {
        <div class="md-receipt-row"><span class="md-receipt-label">Reservation</span><span>@Model.ReservationCode@(Model.TableCode != null ? " · Table " + Model.TableCode : "")</span></div>
    }
    @if (!Model.IsDineIn && Model.PickupTime != null)
    {
        <div class="md-receipt-row"><span class="md-receipt-label">Pick-up</span><span>@Model.PickupTime</span></div>
    }
    <div class="md-receipt-row"><span class="md-receipt-label">Customer</span><span>@Model.CustomerName</span></div>

    <hr class="md-receipt-line" />

    <div class="md-receipt-items">
        @foreach (var item in Model.Items)
        {
            <div class="md-receipt-row">
                <span>@item.Quantity × @item.Name
                    @if (item.Note != null)
                    {
                        <small class="md-receipt-note">@item.Note</small>
                    }
                </span>
                <span>@Rm(item.LineTotal)</span>
            </div>
        }
    </div>

    <hr class="md-receipt-dash" />

    <div class="md-receipt-row"><span>Subtotal</span><span>@Rm(Model.Subtotal)</span></div>
    @if (Model.IsDineIn)
    {
        <div class="md-receipt-row"><span>Service charge 10%</span><span>@Rm(Model.ServiceCharge)</span></div>
    }
    else
    {
        <div class="md-receipt-row md-receipt-label"><span>Service charge</span><span>Dine-in only</span></div>
    }
    <div class="md-receipt-row"><span>SST 6%</span><span>@Rm(Model.Sst)</span></div>
    <div class="md-receipt-row md-receipt-total"><span>Total (RM)</span><span>@Rm(Model.Total)</span></div>

    <div class="md-receipt-pay">
        <div class="md-receipt-row"><span class="md-receipt-label">Payment</span><span>@Model.PaymentMethod · @Model.PaymentStatus</span></div>
        <div class="md-receipt-row"><span class="md-receipt-label">Date/Time</span><span>@Model.PaidAt.ToString("dd.MM.yyyy / HH:mm")</span></div>
    </div>

    <hr class="md-receipt-line" />

    <div class="md-receipt-thanks">Thank you for dining with us!</div>
</div>
