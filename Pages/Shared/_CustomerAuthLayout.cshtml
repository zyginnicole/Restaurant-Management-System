<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @ViewData["Brand"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="md-auth">

        @* Left: restaurant photo + brand *@
        <aside class="md-auth-photo">
            <span class="md-auth-photo-label">INTERIOR PHOTO</span>
            <span class="md-eyebrow">@ViewData["BrandTagline"]</span>
            <div class="md-auth-brand">@ViewData["Brand"]</div>
            <p class="md-auth-tagline">Where every meal becomes a memory, and every occasion is elevated to an art form.</p>
        </aside>

        @* Right: the page's form *@
        <main class="md-auth-form">
            <div class="md-auth-card">
                @RenderBody()
            </div>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
