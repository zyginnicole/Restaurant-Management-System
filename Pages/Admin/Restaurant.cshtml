@page
@model RestaurantManagementSystem.Pages.Admin.RestaurantModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Restaurant Setup";
    ViewData["Module"] = "Admin";
    ViewData["ActiveNav"] = "Restaurant";
    ViewData["Subtitle"] = "Manage the floor plan, service schedules and menu structure";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-setup.css" asp-append-version="true" />
    <style>
        .a-tile-area { display: block; font-size: .7rem; opacity: .75; line-height: 1.3; }
    </style>
}

@section HeaderActions {
    <div class="a-tabs" role="tablist">
        <button class="a-tab active" type="button" role="tab" data-bs-toggle="pill" data-bs-target="#tab-layout">Layout &amp; Tables</button>
        <button class="a-tab" type="button" role="tab" data-bs-toggle="pill" data-bs-target="#tab-hours">Operating Hours &amp; Slots</button>
        <button class="a-tab" type="button" role="tab" data-bs-toggle="pill" data-bs-target="#tab-categories">Menu Categories</button>
    </div>
}

<div class="tab-content">

    @* ================= TAB 1: Layout & Tables ================= *@
    <div class="tab-pane fade show active" id="tab-layout" role="tabpanel">

        <section class="a-card clip">
            <div class="a-card-head">
                <h2 class="a-card-title">Dining Areas</h2>
                <button type="button" class="a-btn" data-bs-toggle="modal" data-bs-target="#areaModal"><i class="bi bi-plus-lg"></i>Add area</button>
            </div>
            <div class="a-areas">
                @foreach (var a in Model.Areas)
                {
                    <div class="a-area" data-switch-scope>
                        <div class="a-area-top">
                            <h3 class="a-area-name">@a.Name</h3>
                            <input type="checkbox" class="a-switch area-active" autocomplete="off" data-id="@a.Id" @(a.Active ? "checked" : "") data-on="Active" data-off="Inactive" aria-label="@a.Name active" />
                        </div>
                        <div class="a-area-meta">@a.TableCount @(a.TableCount == 1 ? "table" : "tables") ·<span title="Every table in this area starts with this code">@a.Code-01, @a.Code-02 …</span><br /><span title="Covers = the total number of guests this area can seat at once (sum of its tables' pax)">@a.Covers covers</span></div>
                        <span class="a-badge @(a.Active ? "active" : "inactive")" data-switch-text>@(a.Active ? "Active" : "Inactive")</span>
                        <div class="d-flex gap-1 mt-2">
                            <button type="button" class="a-icon-btn" data-bs-toggle="modal" data-bs-target="#areaModal" data-json="@a.Json" aria-label="Edit @a.Name"><i class="bi bi-pencil"></i></button>
                            <form method="post" asp-page-handler="DeleteArea" asp-route-id="@a.Id" class="d-inline" data-confirm="Delete the area “@a.Name”? This can't be undone.">
                                <button type="submit" class="a-icon-btn danger" aria-label="Delete @a.Name"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            @if (Model.Areas.Count == 0)
            {
                <p class="a-card-note p-4 mb-0">No dining areas yet. Use “Add area” to create the first one.</p>
            }
        </section>

        <section class="a-card">
            <div class="a-card-head">
                <h2 class="a-card-title">Tables</h2>
                <div class="a-tools">
                    <select id="areaFilter" class="form-select a-input a-input-sm w-auto" aria-label="Filter by dining area">
                        <option value="">All areas</option>
                        @foreach (var a in Model.Areas) { <option value="@a.Id">@a.Name</option> }
                    </select>
                    <select id="capFilter" class="form-select a-input a-input-sm w-auto" aria-label="Filter by capacity">
                        <option value="">All capacities</option>
                        <option value="2">2 pax</option>
                        <option value="4">4 pax</option>
                        <option value="6">6 pax</option>
                        <option value="8">8+ pax</option>
                    </select>
                    <div class="a-legend">
                        <span style="--dot:var(--a-ok)">Available</span>
                        <span style="--dot:var(--a-warn)">Occupied</span>
                        <span style="--dot:var(--a-info)">Reserved</span>
                        <span style="--dot:var(--a-bad)">Maintenance</span>
                    </div>
                    <button type="button" class="a-btn" data-bs-toggle="modal" data-bs-target="#tableModal"><i class="bi bi-plus-lg"></i>Add table</button>
                </div>
            </div>
            <div class="a-tiles" id="tileGrid">
                @foreach (var t in Model.Tables)
                {
                    <button type="button" class="a-tile" data-bs-toggle="modal" data-bs-target="#tableModal"
                            data-id="@t.Id" data-number="@t.Number" data-seats="@t.Seats" data-status="@t.Status" data-area-id="@t.AreaId">
                        <strong>@t.Number</strong>
                        <small>@t.Seats pax</small>
                        <span class="a-tile-area">@t.Area</span>
                        <span class="a-badge @t.Status.ToLower()">@t.Status</span>
                    </button>
                }
            </div>
            @if (Model.Tables.Count == 0)
            {
                <p class="a-card-note p-4 mb-0">No tables yet. Use “Add table” to create the first one.</p>
            }
        </section>
    </div>

    @* ================= TAB 2: Operating Hours & Slots ================= *@
    <div class="tab-pane fade" id="tab-hours" role="tabpanel">

        @* Empty forms: the inputs below join them with form="..." so the card layout stays as it was *@
        <form id="hoursForm" method="post" asp-page-handler="SaveHours"><input type="hidden" name="date" class="slot-date-field" value="@Model.SlotDate" /></form>
        <form id="slotSettingsForm" method="post" asp-page-handler="SaveSlotSettings"><input type="hidden" name="date" class="slot-date-field" value="@Model.SlotDate" /></form>

        <section class="a-card">
            <div class="a-card-head">
                <h2 class="a-card-title">Weekly Opening Hours</h2>
                <button type="submit" form="hoursForm" class="a-btn solid">Save hours</button>
            </div>
            @for (var i = 0; i < Model.Hours.Count; i++)
            {
                var h = Model.Hours[i];
                <div class="a-hours @(h.Open ? "" : "is-closed")">
                    <strong>@h.Name</strong>
                    <input type="hidden" form="hoursForm" name="hours[@i].Day" value="@h.Name" />
                    <label class="a-switch-wrap" data-switch-scope>
                        <input type="checkbox" form="hoursForm" class="a-switch hour-open" name="hours[@i].Open" value="true" autocomplete="off" @(h.Open ? "checked" : "") data-on="Open" data-off="Closed" aria-label="@h.Name open" />
                        <span data-switch-text>@(h.Open ? "Open" : "Closed")</span>
                    </label>
                    @* sends "false" when the switch is off (an unticked checkbox sends nothing) *@
                    <input type="hidden" form="hoursForm" name="hours[@i].Open" value="false" />
                    <div class="times">
                        <input type="time" form="hoursForm" name="hours[@i].From" class="form-control a-input a-input-sm" value="@h.From" aria-label="@h.Name opens" />
                        <span class="a-card-note">to</span>
                        <input type="time" form="hoursForm" name="hours[@i].To" class="form-control a-input a-input-sm" value="@h.To" aria-label="@h.Name closes" />
                    </div>
                </div>
            }
        </section>

        <section class="a-card">
            <div class="a-card-head">
                <h2 class="a-card-title">Booking Slots</h2>
                <span class="a-card-note">Slots are generated from the opening hours above</span>
            </div>
            <div class="a-card-body">
                <div class="row g-3 mb-4 align-items-end">
                    <div class="col-sm-6 col-lg-3">
                        <label class="a-label" for="slotGap">Slot interval</label>
                        <select id="slotGap" form="slotSettingsForm" name="interval" class="form-select a-input">
                            <option value="15" selected="@(Model.SlotInterval == 15)">15 minutes</option>
                            <option value="30" selected="@(Model.SlotInterval == 30)">30 minutes</option>
                            <option value="60" selected="@(Model.SlotInterval == 60)">60 minutes</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="a-label" for="lastSeat">Last seating before close</label>
                        <select id="lastSeat" form="slotSettingsForm" name="lastSeating" class="form-select a-input">
                            <option value="30" selected="@(Model.LastSeating == 30)">30 minutes</option>
                            <option value="60" selected="@(Model.LastSeating == 60)">60 minutes</option>
                            <option value="90" selected="@(Model.LastSeating == 90)">90 minutes</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <button type="submit" form="slotSettingsForm" class="a-btn">Save slot settings</button>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-lg-3">
                        <label class="a-label" for="slotDate">Date</label>
                        <input type="date" id="slotDate" class="form-control a-input" value="@Model.SlotDate" min="@Model.Today" />
                    </div>
                </div>
                <div id="slotInfo" class="a-card-note mb-2"></div>
                <div class="a-chips" id="slotChips"></div>
            </div>
        </section>
    </div>

    @* ================= TAB 3: Menu Categories ================= *@
    <div class="tab-pane fade" id="tab-categories" role="tabpanel">
        <section class="a-card">
            <div class="a-card-head">
                <h2 class="a-card-title">Menu Categories</h2>
                <button type="button" class="a-btn" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-plus-lg"></i>Add category</button>
            </div>
            @foreach (var c in Model.Categories)
            {
                <div class="a-row" data-switch-scope>
                    <i class="bi bi-grip-vertical a-grip" aria-hidden="true"></i>
                    <div class="grow">
                        <strong>@c.Name</strong>
                    </div>
                    <span class="a-card-note d-none d-sm-inline">@c.Items items</span>
                    <label class="a-switch-wrap">
                        <input type="checkbox" class="a-switch category-active" autocomplete="off" data-id="@c.Id" @(c.Active ? "checked" : "") data-on="Visible" data-off="Hidden" aria-label="@c.Name visible" />
                        <span data-switch-text>@(c.Active ? "Visible" : "Hidden")</span>
                    </label>
                    <button type="button" class="a-icon-btn" data-bs-toggle="modal" data-bs-target="#categoryModal" data-json="@c.Json" aria-label="Edit @c.Name"><i class="bi bi-pencil"></i></button>
                    <form method="post" asp-page-handler="DeleteCategory" asp-route-id="@c.Id" class="d-inline" data-confirm="Delete the category “@c.Name”? This can't be undone.">
                        <button type="submit" class="a-icon-btn danger" aria-label="Delete @c.Name"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            }
            @if (Model.Categories.Count == 0)
            {
                <p class="a-card-note p-4 mb-0">No menu categories yet. Use “Add category” to create the first one.</p>
            }
        </section>
    </div>
</div>

@* ================= Modals ================= *@
<div class="modal fade" id="areaModal" tabindex="-1" aria-labelledby="areaModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveArea" class="modal-content">
            <input type="hidden" name="id" id="aId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="areaModalTitle">Add dining area</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="a-label" for="aName">Area name</label><input id="aName" name="name" class="form-control a-input" maxlength="50" required placeholder="e.g. Wine Cellar" /></div>
                <div class="mb-3"><label class="a-label" for="aDesc">Description</label><textarea id="aDesc" name="description" class="form-control a-input" rows="2" maxlength="200"></textarea></div>
                @* Only when adding: the area is created with this many tables, numbered with the area's code (e.g. G-01, G-02 for "Garden") *@
                <div id="areaTablesBlock" class="row g-3 mb-3">
                    <div class="col-6"><label class="a-label" for="aTables">Number of tables</label><input id="aTables" name="tableCount" type="number" min="0" max="99" value="0" class="form-control a-input" /></div>
                    <div class="col-6"><label class="a-label" for="aSeats">Seats per table (pax)</label><input id="aSeats" name="seatsPerTable" type="number" min="1" max="20" value="4" class="form-control a-input" /></div>
                    <div class="col-12"><div class="a-card-note" id="aCovers">0 tables · 0 covers</div></div>
                </div>
                <label class="a-switch-wrap"><input type="checkbox" id="aActive" name="active" value="true" class="a-switch" autocomplete="off" checked /> Open for reservations</label>
            </div>
            <div class="modal-footer">
                <button type="button" class="a-btn quiet" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="a-btn solid">Save area</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveTable" class="modal-content">
            <input type="hidden" name="id" id="tId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="tableModalTitle">Edit table</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="a-label" for="tNumber">Table number</label>
                        <input id="tNumber" class="form-control a-input" readonly tabindex="-1" />
                        <div class="a-card-note mt-1">Next number in the area</div>
                    </div>
                    <div class="col-6"><label class="a-label" for="tSeats">Seats (pax)</label><input id="tSeats" name="capacity" type="number" min="1" max="20" required class="form-control a-input" /></div>
                    <div class="col-6">
                        <label class="a-label" for="tArea">Dining area</label>
                        <select id="tArea" name="areaId" class="form-select a-input" required>
                            @foreach (var a in Model.Areas) { <option value="@a.Id" data-code="@a.Code">@a.Name</option> }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="a-label" for="tStatus">Status</label>
                        <select id="tStatus" name="status" class="form-select a-input"><option>Available</option><option>Occupied</option><option>Reserved</option><option>Maintenance</option></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="submit" id="tableDelete" asp-page-handler="DeleteTable" formnovalidate class="a-btn danger"><i class="bi bi-trash"></i>Delete</button>
                <div class="d-flex gap-2">
                    <button type="button" class="a-btn quiet" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="a-btn solid">Save table</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveCategory" class="modal-content">
            <input type="hidden" name="id" id="cId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="categoryModalTitle">Add menu category</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="a-label" for="catName">Category name</label><input id="catName" name="name" class="form-control a-input" maxlength="50" required placeholder="e.g. Cheese Course" /></div>
                <label class="a-switch-wrap"><input type="checkbox" id="catActive" name="active" value="true" class="a-switch" autocomplete="off" checked /> Visible to customers</label>
            </div>
            <div class="modal-footer">
                <button type="button" class="a-btn quiet" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="a-btn solid">Save category</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/AdminSetup.js" asp-append-version="true"></script>

    @* Message saved by the page model (e.g. "Table T-08 added") shows once after the redirect *@
    @if (TempData["Toast"] is string toastMessage)
    {
        <script>adm.toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastMessage)));</script>
    }

    @* Stay on the tab the admin was on: after a save (set by the page model) and after a refresh (remembered by the browser) *@
    <script>
        (function () {
            const saved = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Tab"] as string));
            const KEY = 'adminRestaurantTab';

            window.addEventListener('load', () => {
                let target = saved ? '#' + saved : null;
                try { if (!target) target = localStorage.getItem(KEY); } catch (e) { }

                const btn = target ? document.querySelector('[data-bs-target="' + target + '"]') : null;
                if (btn && !btn.classList.contains('active')) {
                    if (window.bootstrap) bootstrap.Tab.getOrCreateInstance(btn).show(); else btn.click();
                }

                document.querySelectorAll('.a-tab').forEach(b => b.addEventListener('shown.bs.tab', () => {
                    try { localStorage.setItem(KEY, b.dataset.bsTarget); } catch (e) { }
                }));
            });
        })();
    </script>

    <script>
        (function () {
            const $ = id => document.getElementById(id);
            const modalEl = $('tableModal');
            const tiles = () => document.querySelectorAll('#tileGrid .a-tile');
            let current = null;

            // ---------- Filters (area + capacity work together) ----------
            function applyFilter() {
                const cap = $('capFilter').value, area = $('areaFilter').value;
                tiles().forEach(t => {
                    const s = +t.dataset.seats;
                    const capOk = cap === '' || (cap === '8' ? s >= 8 : s === +cap);
                    const areaOk = area === '' || t.dataset.areaId === area;
                    t.classList.toggle('d-none', !(capOk && areaOk));
                });
            }
            $('capFilter').addEventListener('change', applyFilter);
            $('areaFilter').addEventListener('change', applyFilter);

            // ---------- Table form ----------
            // Preview only: the server works out the real number when you save
            const numberPart = text => { const m = /(\d+)\s*$/.exec(text); return m ? parseInt(m[1], 10) : 0; };
            function previewNumber() {
                const areaId = $('tArea').value;
                if (current && current.dataset.areaId === areaId) { $('tNumber').value = current.dataset.number; return; }
                let max = 0;
                tiles().forEach(t => { if (t.dataset.areaId === areaId) max = Math.max(max, numberPart(t.dataset.number)); });
                const option = $('tArea').selectedOptions[0];
                const code = option ? option.dataset.code : '';
                $('tNumber').value = max >= 99 || !code ? '' : code + '-' + String(max + 1).padStart(2, '0');
            }
            $('tArea').addEventListener('change', previewNumber);

            modalEl.addEventListener('show.bs.modal', e => {
                const b = e.relatedTarget;
                current = b && b.classList.contains('a-tile') ? b : null;
                $('tableModalTitle').textContent = current ? 'Edit table' : 'Add table';
                $('tId').value = current ? current.dataset.id : '';
                $('tSeats').value = current ? current.dataset.seats : 4;
                // a new table starts in the area currently being filtered, if any
                $('tArea').value = current ? current.dataset.areaId : ($('areaFilter').value || ($('tArea').options[0] ? $('tArea').options[0].value : ''));
                $('tStatus').value = current ? current.dataset.status : 'Available';
                previewNumber();
                $('tableDelete').classList.toggle('d-none', !current);
            });

            $('tableDelete').addEventListener('click', e => {
                if (!confirm('Delete table ' + $('tNumber').value + '? This can\'t be undone.')) e.preventDefault();
            });

            // ---------- Area form: empty for "Add", filled for "Edit" ----------
            $('areaModal').addEventListener('show.bs.modal', e => {
                const b = e.relatedTarget;
                const d = b && b.dataset.json ? JSON.parse(b.dataset.json) : null;
                $('areaModalTitle').textContent = d ? 'Edit dining area' : 'Add dining area';
                $('aId').value = d ? d.id : '';
                $('aName').value = d ? d.name : '';
                $('aDesc').value = d ? d.desc : '';
                $('aActive').checked = d ? b.closest('.a-area').querySelector('.area-active').checked : true;

                // starting tables are only for a new area
                $('areaTablesBlock').classList.toggle('d-none', !!d);
                $('aTables').disabled = !!d;
                $('aSeats').disabled = !!d;
                $('aTables').value = 0;
                $('aSeats').value = 4;
                updateCovers();
            });

            // covers = tables x pax per table
            function updateCovers() {
                const n = parseInt($('aTables').value, 10) || 0, s = parseInt($('aSeats').value, 10) || 0;
                $('aCovers').textContent = n + ' tables · ' + (n * s) + ' covers';
            }
            $('aTables').addEventListener('input', updateCovers);
            $('aSeats').addEventListener('input', updateCovers);

            // ---------- Active / inactive switch on an area card saves straight away ----------
            document.querySelectorAll('.area-active').forEach(sw => {
                sw.addEventListener('change', async () => {
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                        const res = await fetch('?handler=ToggleArea', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ id: sw.dataset.id, active: sw.checked })
                        });
                        if (!res.ok) throw new Error('save failed');
                    } catch (err) {
                        adm.toast('Could not save the change. Reloading the page…');
                        setTimeout(() => location.reload(), 1200);
                    }
                });
            });

            // ---------- Opening hours: the switch updates the label and greys out the row ----------
            document.querySelectorAll('.hour-open').forEach(sw => {
                const sync = () => {
                    const row = sw.closest('.a-hours');
                    row.classList.toggle('is-closed', !sw.checked);
                    const label = row.querySelector('[data-switch-text]');
                    if (label) label.textContent = sw.checked ? sw.dataset.on : sw.dataset.off;
                };
                sw.addEventListener('change', sync);
                sync();
            });

            // ---------- Booking slots for one date ----------
            const slotDate = $('slotDate'), slotChips = $('slotChips'), slotInfo = $('slotInfo');
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            async function loadSlots() {
                if (!slotDate.value) return;
                slotInfo.textContent = 'Loading slots…';
                slotChips.innerHTML = '';
                try {
                    const res = await fetch('?handler=Slots&date=' + encodeURIComponent(slotDate.value));
                    if (!res.ok) throw new Error('load failed');
                    const data = await res.json();
                    if (data.closed) {
                        slotInfo.textContent = 'The restaurant is closed on this day, so there are no slots.';
                        return;
                    }
                    slotInfo.textContent = 'Highlighted slots can be booked. Click a slot to block or allow it. Blocking never cancels existing reservations.';
                    data.slots.forEach(s => {
                        const b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'a-chip' + (s.blocked ? '' : ' on');
                        b.setAttribute('aria-pressed', s.blocked ? 'false' : 'true');
                        b.dataset.time = s.time;
                        b.dataset.res = s.reservations;
                        b.dataset.blocked = s.blocked;
                        b.disabled = s.past;
                        b.textContent = s.time + (s.reservations ? ' · ' + s.reservations + ' booked' : '');
                        slotChips.appendChild(b);
                    });
                } catch (err) {
                    slotInfo.textContent = 'Could not load the slots. Please try again.';
                }
            }

            slotChips.addEventListener('click', async e => {
                const chip = e.target.closest('.a-chip');
                if (!chip || chip.disabled) return;
                e.stopPropagation();

                const block = chip.dataset.blocked !== 'true';   // a bookable slot gets blocked, a blocked one gets allowed
                const booked = parseInt(chip.dataset.res, 10) || 0;
                if (block && booked > 0 &&
                    !confirm(booked + ' reservation(s) already exist at ' + chip.dataset.time + '. Blocking only stops NEW bookings; the existing reservations stay. Block this slot?'))
                    return;

                try {
                    const res = await fetch('?handler=ToggleSlot', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token(), 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ date: slotDate.value, time: chip.dataset.time, blocked: block })
                    });
                    if (!res.ok) throw new Error('save failed');
                    chip.dataset.blocked = block;
                    chip.classList.toggle('on', !block);
                    chip.setAttribute('aria-pressed', block ? 'false' : 'true');
                } catch (err) {
                    adm.toast('Could not save the change. Reloading the slots…');
                    loadSlots();
                }
            });

            // the chosen date travels with the two save forms, so the page comes back on the same date
            const syncDate = () => document.querySelectorAll('.slot-date-field').forEach(f => f.value = slotDate.value);
            slotDate.addEventListener('change', () => { syncDate(); loadSlots(); });
            syncDate();
            loadSlots();
            document.querySelector('[data-bs-target="#tab-hours"]').addEventListener('shown.bs.tab', loadSlots);

            // ---------- Menu categories ----------
            $('categoryModal').addEventListener('show.bs.modal', e => {
                const b = e.relatedTarget;
                const d = b && b.dataset.json ? JSON.parse(b.dataset.json) : null;
                $('categoryModalTitle').textContent = d ? 'Edit menu category' : 'Add menu category';
                $('cId').value = d ? d.id : '';
                $('catName').value = d ? d.name : '';
                $('catActive').checked = d ? b.closest('.a-row').querySelector('.category-active').checked : true;
            });

            // Visible / Hidden switch saves straight away
            document.querySelectorAll('.category-active').forEach(sw => {
                sw.addEventListener('change', async () => {
                    try {
                        const res = await fetch('?handler=ToggleCategory', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token(), 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ id: sw.dataset.id, active: sw.checked })
                        });
                        if (!res.ok) throw new Error('save failed');
                    } catch (err) {
                        adm.toast('Could not save the change. Reloading the page…');
                        setTimeout(() => location.reload(), 1200);
                    }
                });
            });

            // ---------- Ask before deleting an area ----------
            document.addEventListener('submit', e => {
                const msg = e.target.dataset && e.target.dataset.confirm;
                if (msg && !confirm(msg)) e.preventDefault();
            });
        })();
    </script>
}
