    ViewData["Module"] = "Staff";
    ViewData["ActiveNav"] = "Guests";
    ViewData["Eyebrow"] = "Wednesday, 16 September 2026 · Dinner service";
    ViewData["Heading"] = "Guests";
    ViewData["Subtitle"] = "Know your guests: preferences, notes and past visits";
    Layout = "_DashboardLayout";

