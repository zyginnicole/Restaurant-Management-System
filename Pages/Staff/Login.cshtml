@page
@model RestaurantManagementSystem.Pages.Staff.LoginModel
@{
    ViewData["Title"] = "Staff Portal";
    Layout = "_StaffAuthLayout";
}

@* Bootstrap Icons (eye icon), as on the Register page *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

@* One sign-in page for both roles. The tabs only switch the heading and the hidden "role" value. *@
<div class="text-center">
    <span class="md-eyebrow md-portal-eyebrow">@ViewData["Brand"]</span>
    <h1 class="md-portal-title" id="portalTitle">Staff Portal</h1>
    <span class="md-portal-divider"></span>
</div>

<div class="md-portal-tabs" role="tablist" aria-label="Sign in as">
    <button type="button" class="md-portal-tab active" role="tab" aria-selected="true"
            data-role="Staff" data-title="Staff Portal" data-placeholder="name@maisondoree.my">
        Staff
    </button>
    <button type="button" class="md-portal-tab" role="tab" aria-selected="false"
            data-role="Admin" data-title="Administration" data-placeholder="admin@maisondoree.my">
        Administrator
    </button>
</div>

<div class="md-portal-card">
    @* Error message – show it from the PageModel when sign-in fails (remove d-none). *@
    <div class="md-alert-danger mb-4 d-none" role="alert">
        Incorrect email or password.
    </div>

    @* role = "Staff" → check the Staff table (staffEmail / staffPassword)
       role = "Admin" → check the Admin table (adminEmail / adminPassword) *@
    <form method="post">
        <input type="hidden" id="role" name="role" value="Staff" />

        <div class="mb-3">
            <label class="md-label" for="email">Email address</label>
            <input class="form-control md-input md-input-dark" id="email" name="email" type="email"
                   placeholder="name@maisondoree.my" autocomplete="username" required />
        </div>

        <div class="mb-4">
            <label class="md-label" for="password">Password</label>
            @* Eye button shows / hides the password (same as Register, wwwroot/js/function.js) *@
            <div class="position-relative">
                <input class="form-control md-input md-input-dark pe-5" id="password" name="password" type="password"
                       placeholder="••••••••" autocomplete="current-password" required />
                <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                        style="right: .75rem; line-height: 1; font-size: 1rem; color: #8a8478;"
                        data-toggle-password="password" aria-label="Show password" aria-pressed="false">
                    <i class="bi bi-eye-slash"></i>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-md-gold w-100">Sign in</button>
    </form>
</div>

<p class="md-portal-note">Contact management for access issues</p>

@section Scripts {
    @* Show / hide password (eye button) *@
    <script src="~/js/function.js" asp-append-version="true"></script>
    <script>
        // Switch between the Staff and Administrator tabs (Staff is the default).
        var brand = document.title.split(' · ').slice(1).join(' · ');

        document.querySelectorAll('.md-portal-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.md-portal-tab').forEach(function (t) {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                tab.classList.add('active');
                tab.setAttribute('aria-selected', 'true');

                document.getElementById('role').value = tab.dataset.role;
                document.getElementById('portalTitle').textContent = tab.dataset.title;
                document.getElementById('email').placeholder = tab.dataset.placeholder;
                document.title = tab.dataset.title + ' · ' + brand;
            });
        });
    </script>
}
