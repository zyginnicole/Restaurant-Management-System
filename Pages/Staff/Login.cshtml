@page
@model RestaurantManagementSystem.Pages.Staff.LoginModel
@using RestaurantManagementSystem.Helpers
@{
    ViewData["Title"] = "Staff Portal";
    Layout = "_StaffAuthLayout";

    // Stay on the tab that was used after a failed sign-in, or open Administrator when coming from an /Admin page
    bool adminTab = Model.Role == UserRoles.Admin;
}

@* Bootstrap Icons (eye icon), as on the Register page *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

@* One sign-in page for both roles. The tabs only switch the heading and the hidden "role" value. *@
<div class="text-center">
    <span class="md-eyebrow md-portal-eyebrow">@ViewData["Brand"]</span>
    <h1 class="md-portal-title" id="portalTitle">@(adminTab ? "Administration" : "Staff Portal")</h1>
    <span class="md-portal-divider"></span>
</div>

<div class="md-portal-tabs" role="tablist" aria-label="Sign in as">
    <button type="button" class="md-portal-tab @(adminTab ? "" : "active")" role="tab" aria-selected="@(adminTab ? "false" : "true")"
            data-role="Staff" data-title="Staff Portal" data-placeholder="name@lumiere.my">
        Staff
    </button>
    <button type="button" class="md-portal-tab @(adminTab ? "active" : "")" role="tab" aria-selected="@(adminTab ? "true" : "false")"
            data-role="Admin" data-title="Administration" data-placeholder="admin@lumiere.my">
        Administrator
    </button>
</div>

<div class="md-portal-card">
    @* Blue notice from RequireRoleFilter: "Please sign in to continue" or "signed out after X minutes without activity" *@
    @if (TempData["LoginNotice"] is string loginNotice)
    {
        <div class="md-note-box md-note-box-info mb-4" role="status">@loginNotice</div>
    }

    @* Error from the PageModel: wrong details + attempts left, account locked, or account deactivated *@
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="md-alert-danger mb-4" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @* role = "Staff" → check the Staff table (staffEmail / staffPassword)
       role = "Admin" → check the Admin table (adminEmail / adminPassword)
       The role only picks the table; the session role always comes from the table that matched. *@
    <form method="post">
        <input type="hidden" id="role" name="role" value="@(adminTab ? "Admin" : "Staff")" />
        @* The page to go back to after signing in (only pages inside the user's own area are accepted) *@
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        <div class="mb-3">
            <label class="md-label" for="email">Email address</label>
            <input class="form-control md-input md-input-dark" id="email" name="email" type="email" value="@Model.Email"
                   placeholder="@(adminTab ? "admin@lumiere.my" : "name@lumiere.my")" autocomplete="username" required />
        </div>

        <div class="mb-4">
            <label class="md-label" for="password">Password</label>
            @* Eye button shows / hides the password (same as Register, wwwroot/js/function.js) *@
            <div class="position-relative">
                <input class="form-control md-input md-input-dark pe-5" id="password" name="password" type="password"
                       placeholder="••••••••" autocomplete="current-password" required />
                <button type="button" class="btn border-0 p-0 shadow-none position-absolute top-50 translate-middle-y"
                        style="right: .75rem; line-height: 1; font-size: 1rem; color: #8a8478;"
                        data-toggle-password="password" aria-label="Show password" aria-pressed="false">
                    <i class="bi bi-eye-slash"></i>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-md-gold w-100">Sign in</button>
    </form>
</div>

<p class="md-portal-note">Forgot your password? Ask an administrator to reset it.</p>

@section Scripts {
    @* Show / hide password (eye button) *@
    <script src="~/js/function.js" asp-append-version="true"></script>
    <script>
        // Switch between the Staff and Administrator tabs (Staff is the default).
        var brand = document.title.split(' · ').slice(1).join(' · ');

        document.querySelectorAll('.md-portal-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.md-portal-tab').forEach(function (t) {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                tab.classList.add('active');
                tab.setAttribute('aria-selected', 'true');

                document.getElementById('role').value = tab.dataset.role;
                document.getElementById('portalTitle').textContent = tab.dataset.title;
                document.getElementById('email').placeholder = tab.dataset.placeholder;
                document.title = tab.dataset.title + ' · ' + brand;
            });
        });
    </script>
}