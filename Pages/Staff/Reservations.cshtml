@page
@model RestaurantManagementSystem.Pages.Staff.ReservationsModel
@{
    ViewData["Title"] = "Reservations";
    ViewData["Module"] = "Staff";
    ViewData["ActiveNav"] = "Reservations";
    ViewData["Eyebrow"] = "Wednesday, 16 September 2026 · Dinner service";
    ViewData["Heading"] = "Reservations";
    ViewData["Subtitle"] = "Approve, seat and manage tonight's bookings";
    Layout = "_DashboardLayout";

    // ---------- Example data – later from the database (see ReservationsModel) ----------
    var now = "20:40";

    // Floor: DiningTable (tableNumber, diningArea, tableCapacity) + state for right now
    // State: free (Available) · seated (Occupied) · reserved (Reserved – Info = time of the booking) · unavailable (Maintenance)
    var tables = new (string No, string Area, int Seats, string State, string Info)[]
    {
        ("T-01", "Indoor", 4, "free", "Free"),          ("T-02", "Outdoor", 4, "reserved", "20:45"),
        ("T-03", "Indoor", 2, "seated", "Seated"),      ("T-04", "Indoor", 2, "reserved", "21:00"),
        ("T-05", "Indoor", 4, "free", "Free"),          ("T-06", "Indoor", 2, "seated", "Seated"),
        ("T-07", "Indoor", 4, "free", "Free"),          ("T-08", "Indoor", 4, "free", "Free"),
        ("T-09", "Indoor", 4, "free", "Free"),          ("T-10", "Indoor", 6, "free", "Free"),
        ("T-11", "Indoor", 4, "free", "Free"),          ("T-12", "Indoor", 4, "seated", "Seated"),
        ("T-13", "Outdoor", 4, "free", "Free"),         ("T-14", "Outdoor", 4, "free", "Free"),
        ("T-15", "Outdoor", 2, "free", "Free"),         ("T-16", "Outdoor", 4, "free", "Free"),
        ("T-17", "Outdoor", 4, "free", "Free"),         ("T-18", "Outdoor", 6, "free", "Free"),
        ("T-19", "Outdoor", 2, "free", "Free"),         ("T-20", "VIP", 8, "reserved", "20:00"),
        ("T-21", "VIP", 8, "free", "Free"),             ("T-22", "VIP", 6, "free", "Free"),
        ("T-23", "VIP", 6, "unavailable", "Closed"),    ("T-24", "VIP", 4, "unavailable", "Out of service")
    };
    int CountTables(string state) => tables.Count(t => t.State == state);

    // Bookings for the chosen day. Status: Pending, Confirmed, Seated (Confirmed + table Occupied), Completed, Cancelled
    var bookings = new (string Time, string Name, string Code, string Table, string Area, int Guests, string Phone,
                        string? Note, string? Allergy, string Status, string? SeatedAt, bool WalkIn)[]
    {
        ("18:00", "Thomas Ashford",    "R-0039", "T-09", "Indoor", 3, "+60 12-876 5432", null, "Shellfish", "Completed", null, false),
        ("18:15", "Amelia Ross",       "R-0038", "T-07", "Indoor", 2, "+60 14-567 8901", "Did not arrive — marked as no-show at 18:45", null, "No-show", null, false),
        ("18:30", "George Pemberton",  "R-0040", "T-21", "VIP",    8, "+60 16-456 7890", "Corporate event — cancelled by customer on 15 Sep", null, "Cancelled", null, false),
        ("19:00", "Eleanor Whitmore",  "R-0041", "T-12", "Indoor", 4, "+60 12-012 3456", "Anniversary dinner — window seating preferred", null, "Seated", "19:04", false),
        ("19:30", "Marcus Delacroix",  "R-0042", "T-06", "Indoor", 2, "+60 17-098 7654", "Champagne on arrival", null, "Seated", "19:33", false),
        ("20:00", "Sophia Haines",     "R-0043", "T-20", "VIP",    6, "+60 19-234 5678", "One guest vegetarian, separate plating", null, "Pending", null, false),
        ("20:15", "Daniel Tan",        "R-0047", "T-03", "Indoor", 2, "+60 11-223 4455", null, null, "Seated", "20:15", true),
        ("20:45", "Victoria Blake",    "R-0044", "T-02", "Outdoor", 4, "+60 12-234 1111", "Tasting menu requested", null, "Confirmed", null, false),
        ("21:00", "Isabella Chen",     "R-0045", "T-04", "Indoor", 2, "+60 13-345 6789", null, null, "Pending", null, false),
        ("21:30", "Henry Wong",        "R-0046", "T-22", "VIP",   10, "+60 18-765 4321", "Declined: party too large for available tables", null, "Declined", null, false)
    };
    int CountStatus(string status) => bookings.Count(b => b.Status == status);
    // Reservation.reservationStatus values (stored exactly like this)
    string[] statuses = { "Pending", "Confirmed", "Seated", "Completed", "Cancelled", "No-show", "Declined" };
    // CSS class for a status: "No-show" → "is-noshow", "Declined" → "is-declined"
    string StatusClass(string status) => "is-" + status.Replace("-", "").ToLower();

    // Floor tile → the booking on that table now (Pending / Confirmed / Seated), opened in the details pop-up
    string[] liveStatuses = { "Pending", "Confirmed", "Seated" };
    (string Code, string Name, string Time, string Status)? BookingOn(string table) =>
        bookings.Where(b => b.Table == table && liveStatuses.Contains(b.Status))
                .Select(b => ((string Code, string Name, string Time, string Status)?)(b.Code, b.Name, b.Time, b.Status)).FirstOrDefault();

    // How each booking was made / what happened (shown at the top of the details pop-up)
    var booked = new Dictionary<string, string>
    {
        ["R-0038"] = "Booked online on 11 Sep 2026, 19:20 · marked as no-show at 18:45",
        ["R-0039"] = "Booked online on 10 Sep 2026, 14:02",
        ["R-0040"] = "Cancelled by the guest on 15 Sep 2026, 09:12",
        ["R-0041"] = "Booked online on 2 Sep 2026, 20:15",
        ["R-0042"] = "Booked by phone on 14 Sep 2026, 11:40",
        ["R-0043"] = "Requested online on 15 Sep 2026, 22:41 · waiting for staff approval",
        ["R-0044"] = "Booked online on 12 Sep 2026, 18:05 · confirmed by Sophie Clarke",
        ["R-0045"] = "Requested online on 16 Sep 2026, 08:30 · waiting for staff approval",
        ["R-0046"] = "Requested online on 15 Sep 2026, 13:05 · declined by Sophie Clarke: party too large for available tables",
        ["R-0047"] = "Walk-in seated by Sophie Clarke at 20:15"
    };
    string[] endedStatuses = { "Completed", "Cancelled", "No-show", "Declined" };

}

@* Message after an action (TempData["StaffMessage"] set by the PageModel) *@
@if (TempData["StaffMessage"] is string message)
{
    <div class="md-alert-success md-section" role="status"><i class="bi bi-check-circle me-2"></i>@message</div>
}

@* =====================================================
   Floor status – one tile per DiningTable. Colours match the reservation status tags:
   Seated yellow · Reserved blue · Free white · Unavailable grey
   Click opens the table pop-up below:
     free table             → "Reserve a Table" with Book Table
     seated / reserved table → "Table T-02" with View upcoming booking (details pop-up) and Book Table (a later time)
   Book Table → /Staff/WalkIn?table=T-02 (Book reservations). Unavailable tables can't be clicked.
   ===================================================== *@
<section class="md-card md-section">
    <div class="md-card-header">
        <span class="md-card-label">Floor status · now @now</span>
        <span class="md-card-meta">Updates live</span>
    </div>
    <div class="md-card-body">
        <ul class="md-floor" aria-label="Tables">
            @foreach (var t in tables)
            {
                var booking = BookingOn(t.No);
                <li>
                    @if (t.State != "unavailable")
                    {
                        @* data-booking (code · name · time · status) only on a seated / reserved table *@
                        <button type="button" class="md-floor-table is-@t.State" title="@t.No · @t.Area · @t.Seats seats"
                                data-bs-toggle="modal" data-bs-target="#reserveTablePopup" data-table="@t.No" data-area="@t.Area" data-seats="@t.Seats"
                                data-booking="@booking?.Code" data-name="@booking?.Name" data-time="@booking?.Time" data-status="@booking?.Status">
                            <b>@t.No</b>
                            <span>@t.Info</span>
                        </button>
                    }
                    else
                    {
                        <div class="md-floor-table is-@t.State" title="@t.No · @t.Area · @t.Seats seats">
                            <b>@t.No</b>
                            <span>@t.Info</span>
                        </div>
                    }
                </li>
            }
        </ul>
        <ul class="md-floor-legend">
            <li><i class="is-seated"></i>Seated <b>@CountTables("seated")</b></li>
            <li><i class="is-reserved"></i>Reserved later <b>@CountTables("reserved")</b></li>
            <li><i class="is-free"></i>Free <b>@CountTables("free")</b></li>
            <li><i class="is-unavailable"></i>Unavailable <b>@CountTables("unavailable")</b></li>
        </ul>
    </div>
</section>

@* =====================================================
   Bookings – status tabs, filters and one row per Reservation
   ===================================================== *@
<section class="md-card md-section md-panel md-res-bookings" id="bookings">
    @* One row of filters: date (backend: ?date=2026-09-16), service, area, status, search.
       The page filters the rows on screen. *@
    <div class="md-res-filters">
        <div class="md-res-filter-row">
            <div class="md-res-date">
                <a class="btn btn-md-outline md-btn-sm" href="?date=2026-09-15" aria-label="Previous day"><i class="bi bi-chevron-left"></i></a>
                <input type="date" class="form-control md-input" value="2026-09-16" aria-label="Date" />
                <a class="btn btn-md-outline md-btn-sm" href="?date=2026-09-17" aria-label="Next day"><i class="bi bi-chevron-right"></i></a>
            </div>
            <div class="md-segment md-segment-sm" role="group" aria-label="Service" id="resService">
                <button type="button" data-service="all">All day</button>
                <button type="button" data-service="lunch">Lunch</button>
                <button type="button" class="active" data-service="dinner">Dinner</button>
            </div>
            <select class="form-select md-input md-res-area" id="resArea" aria-label="Area">
                <option value="all">All areas</option>
                <option>Indoor</option>
                <option>Outdoor</option>
                <option>VIP</option>
            </select>
            @* Status + search stay together on one line (the search fills the rest of the row) *@
            <div class="md-res-filter-end">
                @* Reservation.reservationStatus – number of bookings for the day in brackets *@
                <select class="form-select md-input md-res-status" id="resStatus" aria-label="Status">
                    <option value="all">All statuses (@bookings.Length)</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s">@s (@CountStatus(s))</option>
                    }
                </select>
                <input type="search" class="form-control md-input md-res-search" id="resSearch" placeholder="Search bookings" title="Search by name, phone or R-number" aria-label="Search bookings by name, phone or R-number" />
            </div>
        </div>
    </div>

    <ul class="md-guest-list" id="resList">
        @* Newest first (latest time at the top) – backend: OrderByDescending(r => r.reservationDateTime) *@
        @foreach (var b in bookings.OrderByDescending(b => b.Time))
        {
            string key = StatusClass(b.Status);
            string details = $"{b.Name} · {b.Time} · {b.Guests} guests · {b.Table} {b.Area}";
            @* Whole row opens the Reservation details pop-up (the name is a stretched-link to ?view=R-xxxx);
               the action buttons stay clickable on top. data-* values fill the pop-up (see the script). *@
            <li class="md-guest md-staff-res md-row-link @key" data-status="@b.Status" data-area="@b.Area" data-hour="@(b.Time[..2])"
                data-search="@($"{b.Name} {b.Code} {new string(b.Phone.Where(char.IsDigit).ToArray())}".ToLower())"
                data-code="@b.Code" data-name="@b.Name" data-guests="@b.Guests" data-time="@b.Time" data-table="@b.Table"
                data-seated="@b.SeatedAt" data-walkin="@(b.WalkIn ? "true" : "false")" data-booked="@booked[b.Code]"
                data-request="@(endedStatuses.Contains(b.Status) ? "" : b.Note)" data-details="@details">
                <div class="md-guest-time">@b.Time</div>

                <div class="md-guest-main">
                    <a class="stretched-link md-guest-name" href="?view=@b.Code" data-open-detail>@b.Name@(b.WalkIn ? " · walk-in" : "") <span class="md-guest-code">@b.Code</span></a>
                    <span class="md-guest-meta"><i class="bi bi-lamp md-lamp" aria-hidden="true"></i>@b.Table · @b.Area · @b.Guests guests · @b.Phone</span>
                    @if (b.Allergy != null)
                    {
                        <span class="md-allergy"><i class="bi bi-exclamation-triangle"></i>Allergy: @b.Allergy</span>
                    }
                    @if (b.Note != null)
                    {
                        <span class="md-res-note">“@b.Note”</span>
                    }
                </div>

                <div class="md-staff-res-side">
                    <span class="md-pill @key">@b.Status@(b.SeatedAt != null ? " " + b.SeatedAt : "")</span>
                    <div class="md-order-actions">
                        @switch (b.Status)
                        {
                            case "Pending":
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="reservationId" value="@b.Code" />
                                    <button type="submit" class="btn md-btn-round md-btn-sm md-btn-confirm">Confirm</button>
                                </form>
                                <button type="button" class="btn md-btn-round md-btn-sm md-btn-cancel" data-bs-toggle="modal" data-bs-target="#declinePopup"
                                        data-id="@b.Code" data-code="@b.Code" data-details="@details">Decline</button>
                                break;
                            case "Confirmed":
                                <form method="post" asp-page-handler="Seat">
                                    <input type="hidden" name="reservationId" value="@b.Code" />
                                    <button type="submit" class="btn md-btn-round md-btn-sm md-btn-green">Seat</button>
                                </form>
                                <button type="button" class="btn md-btn-round md-btn-sm md-btn-outline" data-bs-toggle="modal" data-bs-target="#noShowPopup"
                                        data-id="@b.Code" data-code="@b.Code" data-details="@details">No-show</button>
                                <button type="button" class="btn md-btn-round md-btn-sm md-btn-cancel" data-bs-toggle="modal" data-bs-target="#cancelBookingPopup"
                                        data-id="@b.Code" data-code="@b.Code" data-details="@details">Cancel</button>
                                break;
                            case "Seated":
                                @* No buttons: a Seated booking can't be changed and completes by itself when its order is paid (Billing) *@
                                break;
                        }
                    </div>
                </div>
            </li>
        }
    </ul>
    <p class="md-notice-empty d-none" id="resEmpty">No bookings match these filters.</p>
</section>

@* Reservation details pop-up + Decline / Cancel / No-show confirm pop-ups (shared with the Staff Dashboard) *@
<partial name="_ReservationDetailPopup" model="@("/Staff/Reservations")" />

@* ---------- Table pop-up (floor tile) ----------
   Filled from the clicked tile (data-table, data-area, data-seats, and data-booking / name / time / status when booked).
   Free table: "Reserve a Table". Seated / reserved table: "Table T-02" + View upcoming booking (opens the
   Reservation details pop-up). Book Table opens Book reservations (/Staff/WalkIn?table=…) for that table. *@
<div class="modal fade md-popup" id="reserveTablePopup" tabindex="-1" aria-labelledby="reserveTableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow">Floor status</span>
                    <h2 class="modal-title md-popup-title" id="reserveTableTitle">Reserve a Table</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="md-popup-message mb-0" id="reserveTableMessage">—</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn md-btn-round md-btn-outline d-none" id="viewBookingButton">View upcoming booking</button>
                <a class="btn btn-md-dark" href="/Staff/WalkIn" id="reserveTableLink"><i class="bi bi-calendar-plus me-2"></i>Book Table</a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Filters on screen: search text + service (lunch before 16:00) + area + status.
        // Backend: the date arrows reload the page with ?date=…
        (function () {
            var rows = document.querySelectorAll('#resList > li');
            var services = document.querySelectorAll('#resService button');
            var area = document.getElementById('resArea');
            var statusSelect = document.getElementById('resStatus');
            var search = document.getElementById('resSearch');
            var service = 'dinner';

            function apply() {
                var status = statusSelect.value;
                // Phone numbers are matched as digits only, so "0123" finds "+60 12-012 3456"
                var text = search.value.trim().toLowerCase(), digits = text.replace(/[\s+-]/g, ''), shown = 0;
                rows.forEach(function (row) {
                    var hour = parseInt(row.dataset.hour, 10);
                    var ok = (status === 'all' || row.dataset.status === status)
                        && (service === 'all' || (service === 'lunch' ? hour < 16 : hour >= 16))
                        && (area.value === 'all' || row.dataset.area === area.value)
                        && (!text || row.dataset.search.indexOf(text) !== -1 || (/^\d+$/.test(digits) && row.dataset.search.indexOf(digits) !== -1));
                    row.classList.toggle('d-none', !ok);
                    if (ok) shown++;
                });
                document.getElementById('resEmpty').classList.toggle('d-none', shown > 0);
            }

            function pick(buttons, button) {
                buttons.forEach(function (b) { b.classList.toggle('active', b === button); });
            }

            services.forEach(function (b) { b.addEventListener('click', function () { service = b.dataset.service; pick(services, b); apply(); }); });
            area.addEventListener('change', apply);
            statusSelect.addEventListener('change', apply);
            search.addEventListener('input', apply);

            // ?status=Pending (Staff Dashboard "2 need approval"): pick that status, for the whole day,
            // and scroll down to the booking list
            var wanted = new URLSearchParams(location.search).get('status');
            var opened = !!wanted && Array.prototype.some.call(statusSelect.options, function (o) { return o.value === wanted; });
            if (opened) {
                statusSelect.value = wanted;
                service = 'all'; pick(services, document.querySelector('#resService [data-service="all"]'));
            }
            apply();
            if (opened) document.getElementById('bookings').scrollIntoView({ block: 'start', behavior: 'instant' });
        })();

        // Table pop-up: fill in the clicked tile and point Book Table at /Staff/WalkIn?table=…
        (function () {
            var popupEl = document.getElementById('reserveTablePopup');
            var view = document.getElementById('viewBookingButton');
            var message = document.getElementById('reserveTableMessage');

            popupEl.addEventListener('show.bs.modal', function (e) {
                var d = e.relatedTarget.dataset, booked = !!d.booking;
                var table = d.table + ' · ' + d.area + ' · ' + d.seats + ' seats';
                document.getElementById('reserveTableTitle').textContent = booked ? 'Table ' + d.table : 'Reserve a Table';
                message.textContent = !booked
                    ? table + ' is free now. Book this table for a guest?'
                    : table + '. ' + (d.status === 'Seated' ? 'Seated now: ' : d.status + ' at ' + d.time + ': ') +
                      d.name + ' (' + d.booking + '). View that booking, or book this table for another time.';
                view.classList.toggle('d-none', !booked);
                view.dataset.booking = d.booking || '';
                document.getElementById('reserveTableLink').href = '/Staff/WalkIn?table=' + encodeURIComponent(d.table);
            });

            // View upcoming booking: close this pop-up, then open the Reservation details pop-up of that booking
            // (same as clicking its row – see staff-reservation-popup.js)
            view.addEventListener('click', function () {
                var row = document.querySelector('#resList [data-code="' + view.dataset.booking + '"] [data-open-detail]');
                popupEl.addEventListener('hidden.bs.modal', function () { if (row) row.click(); }, { once: true });
                bootstrap.Modal.getInstance(popupEl).hide();
            });
        })();
    </script>
    @* Reservation details pop-up (opens from a row, a booked floor tile, or ?view=R-0043) *@
    @* Table dropdowns open their list below (data-md-select) *@
    <script src="~/js/md-select.js" asp-append-version="true"></script>
    <script src="~/js/staff-reservation-popup.js" asp-append-version="true"></script>
}
