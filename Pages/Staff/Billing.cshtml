@page
@model RestaurantManagementSystem.Pages.Staff.BillingModel
@{
    ViewData["Title"] = "Billing";
    ViewData["Module"] = "Staff";
    ViewData["ActiveNav"] = "Billing";
    ViewData["Eyebrow"] = "Wednesday, 16 September 2026 · Dinner service";
    ViewData["Heading"] = "Billing";
    ViewData["Subtitle"] = "Bills for served tables, payments and receipts";
    Layout = "_DashboardLayout";

    // ---------- Example data – later from the database (see BillingModel) ----------
    // One bill per Order. State: "awaiting" (Served, not paid) · "open" (still dining) · "paid"
    var bills = new (string Code, string Day, string? Table, string Name, string? Res, string State, string OrderStatus,
                     string Placed, string? PaidWith, string? PaidAt, string? Pickup,
                     (int Qty, string Name, string Cat, decimal Price, string? Remark)[] Items)[]
    {
        ("ORD-0083", "tonight", "T-09", "Thomas Ashford", "R-0039", "awaiting", "Served", "18:12", null, null, null,
            new[] { (1, "Oyster Selection", "Starters", 68m, (string?)null), (2, "Duck à l'Orange", "Mains", 92m, null),
                    (2, "Valrhona Chocolate Fondant", "Desserts", 36m, null), (1, "Mille-Feuille", "Desserts", 32m, null),
                    (1, "Sparkling Water", "Beverages", 18m, null) }),
        ("ORD-0085", "tonight", "T-03", "Daniel Tan", "R-0047", "open", "Order placed", "20:22", null, null, null,
            new[] { (1, "Pan-Seared Sea Bass", "Mains", 98m, (string?)"No butter sauce"), (1, "Valrhona Chocolate Fondant", "Desserts", 36m, null) }),
        ("ORD-0082", "tonight", "T-12", "Eleanor Whitmore", "R-0041", "open", "Preparing", "19:20", null, null, null,
            new[] { (2, "Wagyu Beef Tenderloin", "Mains", 168m, (string?)"Medium rare"), (2, "Pan-Seared Sea Bass", "Mains", 98m, null),
                    (4, "Valrhona Chocolate Fondant", "Desserts", 36m, null) }),
        ("ORD-0081", "tonight", "T-06", "Marcus Delacroix", "R-0042", "open", "Preparing", "19:40", null, null, null,
            new[] { (1, "Caviar & Soft Egg", "Starters", 85m, (string?)null), (1, "Wagyu Beef Tenderloin", "Mains", 168m, "Medium"),
                    (1, "Château Margaux 2018 · glass", "Beverages", 120m, null), (1, "Mille-Feuille", "Desserts", 32m, null) }),
        ("ORD-0080", "tonight", "T-11", "Grace Lim", "R-0036", "paid", "Completed", "18:05", "Card", "19:45", null,
            new[] { (2, "Oyster Selection", "Starters", 68m, (string?)null), (2, "Duck à l'Orange", "Mains", 92m, null) }),
        ("ORD-0089", "tonight", null, "Alexandra Beaumont", null, "paid", "Preparing", "20:44", "Card (online)", "20:44", "21:30",
            new[] { (1, "Wagyu Beef Tenderloin", "Mains", 168m, (string?)null), (1, "Valrhona Chocolate Fondant", "Desserts", 36m, null) }),
        ("ORD-0077", "yesterday", "T-05", "Ryan Koh", "R-0033", "paid", "Completed", "19:30", "E-Wallet", "21:10", null,
            new[] { (2, "Wagyu Beef Tenderloin", "Mains", 168m, (string?)"Medium"), (2, "Mille-Feuille", "Desserts", 32m, null),
                    (2, "Sparkling Water", "Beverages", 18m, null) })
    };

    // Totals (same rates as the receipt – ReceiptView)
    decimal R2(decimal v) => Math.Round(v, 2, MidpointRounding.AwayFromZero);
    decimal Sub((int Qty, string Name, string Cat, decimal Price, string? Remark)[] items) => items.Sum(i => i.Qty * i.Price);
    decimal Service(decimal sub, bool dineIn) => dineIn ? R2(sub * ReceiptView.ServiceChargeRate) : 0m;
    decimal Total(decimal sub, bool dineIn) { var s = Service(sub, dineIn); return sub + s + R2((sub + s) * ReceiptView.SstRate); }
    string Rm(decimal v) => "RM " + v.ToString("#,##0.00");
    decimal BillTotal((string Code, string Day, string? Table, string Name, string? Res, string State, string OrderStatus, string Placed, string? PaidWith, string? PaidAt, string? Pickup, (int Qty, string Name, string Cat, decimal Price, string? Remark)[] Items) b)
        => Total(Sub(b.Items), b.Table != null);

    var tonight = bills.Where(b => b.Day == "tonight").ToArray();
    decimal collected = tonight.Where(b => b.State == "paid").Sum(BillTotal);
    decimal awaiting = tonight.Where(b => b.State == "awaiting").Sum(BillTotal);
    var dining = tonight.Where(b => b.State == "open").Select(b => b.Table).ToArray();

    string Pill(string state) => state == "awaiting" ? "is-served" : state == "open" ? "is-preparing" : "is-completed";
    string StateText(string state, string? table) => state == "awaiting" ? "Awaiting payment" : state == "open" ? "Still dining" : table == null ? "Paid online" : "Paid";

    // Active promotions for the Promotion dropdown (Promotion: promoID, promoTitle, discount rule)
    var promotions = new (string Id, string Title, string Rule)[]
    {
        ("", "None", "none"),
        ("2", "Early Dinner · 15% off mains (before 18:30)", "mains15"),
        ("3", "Birthday Dessert · one dessert free", "freeDessert")
    };
}

@* Message after recording a payment (TempData["StaffMessage"]) *@
@if (TempData["StaffMessage"] is string message)
{
    <div class="md-alert-success md-section" role="status"><i class="bi bi-check-circle me-2"></i>@message</div>
}

@* ---------- Tonight at a glance ---------- *@
<div class="row md-grid md-section">
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Collected tonight</span>
            <div class="md-stat-value">@Rm(collected)</div>
            <span class="md-hint">@tonight.Count(b => b.State == "paid") bills paid (1 table, 1 takeaway)</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Awaiting payment</span>
            <div class="md-stat-value">@Rm(awaiting)</div>
            <span class="md-hint">@tonight.Count(b => b.State == "awaiting") table served · @string.Join(", ", tonight.Where(b => b.State == "awaiting").Select(b => b.Table))</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Still dining</span>
            <div class="md-stat-value">@dining.Length tables</div>
            <span class="md-hint">@string.Join(", ", dining.OrderBy(t => t))</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Covers tonight</span>
            <div class="md-stat-value">11</div>
            <span class="md-hint">Guests seated or completed</span>
        </div>
    </div>
</div>

<div class="row md-grid md-section">
    @* ---------- Bill list (left) ---------- *@
    <div class="col-lg-5 col-xl-4">
        <section class="md-card md-staff-orders">
            <nav class="md-tabs md-filter-tabs" aria-label="Bills by day" id="billTabs">
                <button type="button" class="active" data-day="tonight">Tonight <small>@tonight.Length</small></button>
                <button type="button" data-day="yesterday">Yesterday <small>@bills.Count(b => b.Day == "yesterday")</small></button>
                <button type="button" data-day="all">All <small>@bills.Length</small></button>
            </nav>
            @* Awaiting payment first, then still dining, then paid *@
            <ul class="md-order-list" id="billList">
                @foreach (var b in bills.OrderBy(b => b.State == "awaiting" ? 0 : b.State == "open" ? 1 : 2))
                {
                    <li class="md-order md-staff-order @Pill(b.State)" data-day="@b.Day" data-code="@b.Code">
                        <span class="md-table-badge">@(b.Table != null ? b.Table[2..] : "TA")</span>
                        <div class="md-order-main">
                            <button type="button" class="md-staff-order-btn stretched-link" data-show-bill="@b.Code">@(b.Table ?? "Takeaway") · @b.Name</button>
                            <span class="md-guest-meta">@b.Code@(b.Day == "yesterday" ? " · yesterday" : "")@(b.PaidWith != null ? " · " + b.PaidWith : b.State == "open" ? " · " + b.OrderStatus.ToLower() : "")</span>
                        </div>
                        <div class="md-order-side">
                            <span class="md-pill @Pill(b.State)">@StateText(b.State, b.Table)</span>
                            <span class="md-order-amount">@(b.State == "open" ? "—" : Rm(BillTotal(b)))</span>
                        </div>
                    </li>
                }
            </ul>
            <p class="md-notice-empty d-none" id="billEmpty">No bills here.</p>
        </section>
    </div>

    @* ---------- The chosen bill (right) – copied from its <template data-bill> ---------- *@
    <div class="col-lg-7 col-xl-8">
        <div id="billPanel"></div>
    </div>
</div>

@foreach (var b in bills)
{
    bool dineIn = b.Table != null;
    decimal sub = Sub(b.Items);
    <template data-bill="@b.Code">
        @if (b.State == "paid")
        {
            @* ---------- Paid: the receipt ---------- *@
            var receipt = new ReceiptView
            {
                ReceiptNo = "RCP-" + b.Code[4..], OrderCode = b.Code, IsDineIn = dineIn,
                ReservationCode = b.Res, TableCode = b.Table, PickupTime = b.Pickup, CustomerName = b.Name,
                Items = b.Items.Select(i => new ReceiptLine { Quantity = i.Qty, Name = i.Name, UnitPrice = i.Price, Note = i.Remark }).ToList(),
                PaymentMethod = b.PaidWith ?? "", PaymentStatus = "Paid",
                PaidAt = new DateTimeOffset(2026, 9, b.Day == "yesterday" ? 15 : 16, int.Parse(b.PaidAt![..2]), int.Parse(b.PaidAt[3..]), 0, TimeSpan.FromHours(8))
            };
            <section class="md-card">
                <div class="md-card-header">
                    <span class="md-card-label">Receipt · @b.Code · @(b.Table ?? "Takeaway") · @b.Name</span>
                    <span class="md-pill is-completed">@StateText(b.State, b.Table)</span>
                </div>
                <div class="md-card-body">
                    <partial name="~/Pages/Shared/Partials/_Receipt.cshtml" model="receipt" />
                    <div class="md-receipt-actions">
                        <button type="button" class="btn md-btn-round btn-md-dark" data-pdf-target="#receiptPaper" data-pdf-name="MaisonDoree-Receipt-@receipt.ReceiptNo"><i class="bi bi-download me-2"></i>Download receipt (PDF)</button>
                    </div>
                </div>
            </section>
        }
        else
        {
            @* ---------- Awaiting payment / still dining: the bill ---------- *@
            <section class="md-card md-section" id="billCard" data-subtotal="@sub.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-dinein="@(dineIn ? "true" : "false")">
                <div class="md-card-header">
                    <span class="md-card-label">Bill · @b.Code · @(b.Table ?? "Takeaway") · @b.Name</span>
                    <span class="md-pill @Pill(b.State)">@StateText(b.State, b.Table)</span>
                </div>
                @* Only in the downloaded PDF: who and when *@
                <div class="md-card-body md-pdf-only md-pdf-head">
                    <b>@ViewData["Brand"]</b>
                    <span>@(dineIn ? $"Table {b.Table} · reservation {b.Res}" : "Takeaway") · @b.Name · ordered 16 Sep 2026, @b.Placed</span>
                </div>
                <div class="table-responsive">
                    <table class="md-visit-table md-bill-table">
                        <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            @foreach (var i in b.Items)
                            {
                                <tr data-cat="@i.Cat" data-price="@i.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-qty="@i.Qty">
                                    <td>
                                        @i.Name
                                        @if (i.Remark != null)
                                        {
                                            <small class="md-item-note">@i.Remark</small>
                                        }
                                    </td>
                                    <td class="text-end">@i.Qty</td>
                                    <td class="text-end">@Rm(i.Price)</td>
                                    <td class="text-end">@Rm(i.Qty * i.Price)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="md-card-body">
                    <dl class="md-sum md-bill-sum mb-0">
                        <div><dt>Subtotal</dt><dd>@Rm(sub)</dd></div>
                        @if (b.State == "awaiting")
                        {
                            <div class="md-bill-promo">
                                <dt><label for="promotionSelect">Promotion</label></dt>
                                <dd>
                                    @* The dropdown is left out of the PDF; the PDF shows the chosen promotion as text *@
                                    <div data-html2canvas-ignore>
                                        <select class="form-select md-input" id="promotionSelect" name="promotionId" form="payForm" data-md-select>
                                            @foreach (var p in promotions)
                                            {
                                                <option value="@p.Id" data-rule="@p.Rule">@p.Title</option>
                                            }
                                        </select>
                                    </div>
                                    <span class="md-pdf-only" data-bill="promo-text">None</span>
                                </dd>
                            </div>
                            <div class="d-none" data-bill="discount-row"><dt>Discount</dt><dd data-bill="discount">−RM 0.00</dd></div>
                        }
                        <div><dt>Service charge 10%</dt><dd data-bill="service">@Rm(Service(sub, dineIn))</dd></div>
                        <div><dt>SST 6%</dt><dd data-bill="sst">@Rm(Total(sub, dineIn) - sub - Service(sub, dineIn))</dd></div>
                        <div class="md-sum-total"><dt>Total</dt><dd data-bill="total">@Rm(Total(sub, dineIn))</dd></div>
                    </dl>
                    @if (b.State == "open")
                    {
                        <p class="md-note-box md-note-box-info mt-3 mb-3">Still dining: the order is @b.OrderStatus.ToLower(). Payment opens when it has been served.</p>
                        <div class="md-edit-actions">
                            <a class="btn md-btn-round md-btn-outline" href="/Staff/Orders?view=@b.Code">View order</a>
                        </div>
                    }
                </div>
            </section>

            @if (b.State == "awaiting")
            {
                @* ---------- Record payment – posts to OnPostPay ---------- *@
                <form method="post" asp-page-handler="Pay" id="payForm">
                    <input type="hidden" name="orderId" value="@b.Code" />
                    <section class="md-card">
                        <div class="md-card-header">
                            <span class="md-card-label">Record payment</span>
                        </div>
                        <div class="md-card-body">
                            <span class="md-label">Payment method</span>
                            @* Payment.paymentMethod: Cash, Card, E-Wallet (Online Banking is for online payments) *@
                            <div class="md-choice mb-3" role="radiogroup" aria-label="Payment method">
                                <input type="radio" class="btn-check" name="paymentMethod" id="payCash" value="Cash" checked />
                                <label for="payCash">Cash</label>
                                <input type="radio" class="btn-check" name="paymentMethod" id="payCard" value="Card" />
                                <label for="payCard">Card</label>
                                <input type="radio" class="btn-check" name="paymentMethod" id="payWallet" value="E-Wallet" />
                                <label for="payWallet">E-Wallet</label>
                            </div>
                            <div class="row g-3 mb-3" data-pay="Cash">
                                <div class="col-sm-6">
                                    <label class="md-label" for="amountReceived">Amount received (RM)</label>
                                    <input class="form-control md-input" id="amountReceived" name="amountReceived" type="number" min="0" step="0.01" value="@Total(sub, dineIn).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                                </div>
                                <div class="col-sm-6">
                                    <span class="md-label">Change due</span>
                                    <div class="md-bill-change" data-bill="change">RM 0.00</div>
                                </div>
                            </div>
                            <p class="md-hint mb-3 d-none" data-pay="Card">Take the card payment on the terminal, then confirm here.</p>
                            <p class="md-hint mb-3 d-none" data-pay="E-Wallet">Ask the guest to scan the DuitNow QR code, then confirm here once it shows as paid.</p>
                            <p class="md-note-box md-note-box-info mb-3">
                                Confirming payment issues receipt RCP-@b.Code[4..], frees table @b.Table and marks reservation @b.Res as Completed.
                            </p>
                            <div class="md-edit-actions">
                                <button type="submit" class="btn md-btn-round md-btn-green">Confirm payment</button>
                                <button type="button" class="btn md-btn-round md-btn-outline" data-pdf-target="#billCard" data-pdf-name="MaisonDoree-Bill-@b.Code"><i class="bi bi-download me-2"></i>Download bill (PDF)</button>
                            </div>
                        </div>
                    </section>
                </form>
            }
        }
    </template>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="~/js/pdf-download.js" asp-append-version="true"></script>
    <script src="~/js/md-select.js" asp-append-version="true"></script>
    <script>
        (function () {
            var list = document.getElementById('billList');
            var rows = list.querySelectorAll(':scope > li');
            var panel = document.getElementById('billPanel');
            var day = 'tonight';
            var rm = function (n) { return 'RM ' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };
            var r2 = function (n) { return Math.round(n * 100) / 100; };

            // Tabs: Tonight / Yesterday / All
            function applyTab() {
                var shown = 0;
                rows.forEach(function (row) {
                    var ok = day === 'all' || row.dataset.day === day;
                    row.classList.toggle('d-none', !ok);
                    if (ok) shown++;
                });
                document.getElementById('billEmpty').classList.toggle('d-none', shown > 0);
            }
            document.querySelectorAll('#billTabs button').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    day = tab.dataset.day;
                    document.querySelectorAll('#billTabs button').forEach(function (t) { t.classList.toggle('active', t === tab); });
                    applyTab();
                });
            });

            // Totals with the chosen promotion: discount → service charge 10% (dine-in) → SST 6%
            function recalc() {
                var card = document.getElementById('billCard');
                var select = document.getElementById('promotionSelect');
                if (!card || !select) return;
                var rule = select.options[select.selectedIndex].dataset.rule;
                panel.querySelector('[data-bill="promo-text"]').textContent = select.options[select.selectedIndex].text;   // for the PDF
                var lines = Array.prototype.map.call(card.querySelectorAll('tbody tr'), function (tr) {
                    return { cat: tr.dataset.cat, price: parseFloat(tr.dataset.price), qty: parseInt(tr.dataset.qty, 10) };
                });
                var sub = parseFloat(card.dataset.subtotal), discount = 0;
                if (rule === 'mains15') {
                    discount = r2(lines.filter(function (l) { return l.cat === 'Mains'; }).reduce(function (s, l) { return s + l.price * l.qty; }, 0) * 0.15);
                } else if (rule === 'freeDessert') {
                    var desserts = lines.filter(function (l) { return l.cat === 'Desserts'; }).map(function (l) { return l.price; });
                    discount = desserts.length ? Math.min.apply(null, desserts) : 0;
                }
                var base = sub - discount;
                var service = card.dataset.dinein === 'true' ? r2(base * 0.10) : 0;
                var sst = r2((base + service) * 0.06);
                var total = r2(base + service + sst);
                var q = function (n) { return panel.querySelector('[data-bill="' + n + '"]'); };
                q('discount-row').classList.toggle('d-none', discount === 0);
                q('discount').textContent = '−' + rm(discount);
                q('service').textContent = rm(service);
                q('sst').textContent = rm(sst);
                q('total').textContent = rm(total);
                var received = document.getElementById('amountReceived');
                if (received) { received.dataset.total = total; received.value = total.toFixed(2); updateChange(); }
            }

            // Cash: change due
            function updateChange() {
                var received = document.getElementById('amountReceived'), out = panel.querySelector('[data-bill="change"]');
                if (!received || !out) return;
                var change = r2((parseFloat(received.value) || 0) - parseFloat(received.dataset.total || 0));
                out.textContent = change < 0 ? 'Short by ' + rm(-change) : rm(change);
                out.classList.toggle('is-short', change < 0);
            }

            // Show a bill on the right (from its template) and wire up its controls
            function showBill(code, scroll) {
                var template = document.querySelector('template[data-bill="' + code + '"]');
                if (!template) return;
                panel.innerHTML = '';
                panel.appendChild(template.content.cloneNode(true));
                rows.forEach(function (row) { row.classList.toggle('is-selected', row.dataset.code === code); });
                history.replaceState(null, '', '?order=' + code);

                var select = document.getElementById('promotionSelect');
                if (select && window.mdSelect) window.mdSelect(select);
                if (select) select.addEventListener('change', recalc);
                var received = document.getElementById('amountReceived');
                if (received) {
                    received.dataset.total = received.value;
                    received.addEventListener('input', updateChange);
                    updateChange();
                }
                panel.querySelectorAll('input[name="paymentMethod"]').forEach(function (r) {
                    r.addEventListener('change', function () {
                        panel.querySelectorAll('[data-pay]').forEach(function (el) { el.classList.toggle('d-none', el.dataset.pay !== r.value); });
                    });
                });
                if (scroll && window.innerWidth < 992) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            list.querySelectorAll('[data-show-bill]').forEach(function (b) {
                b.addEventListener('click', function () { showBill(b.dataset.showBill, true); });
            });

            // Start: ?order=ORD-0083 (Orders page / Dashboard), otherwise the first bill awaiting payment
            applyTab();
            var wanted = new URLSearchParams(location.search).get('order');
            var row = wanted && list.querySelector('li[data-code="' + wanted + '"]');
            if (row && row.dataset.day !== 'tonight') document.querySelector('#billTabs [data-day="all"]').click();
            var start = row ? wanted : (list.querySelector('li[data-day="tonight"]') || {}).dataset?.code;
            if (start) showBill(start);
        })();
    </script>
}
