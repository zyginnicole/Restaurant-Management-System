@page
@model RestaurantManagementSystem.Pages.Staff.WalkInModel
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var settings = Model.Settings;
    var isToday = Model.Date == DateTime.Today;
    var dateValue = Model.Date.ToString("yyyy-MM-dd", inv);

    ViewData["Title"] = "Book reservations";
    ViewData["Module"] = "Staff";
    ViewData["ActiveNav"] = "Reservations";
    ViewData["Eyebrow"] = Model.Date.ToString("dddd, d MMMM yyyy", inv) + (isToday ? " · Today" : "");
    ViewData["Heading"] = "Book reservations";
    ViewData["Subtitle"] = "Seat a walk-in now or book a table for a guest on any date";
    Layout = "_DashboardLayout";
}

@section HeaderActions {
    <a class="btn btn-md-outline md-header-btn" href="/Staff/Reservations?date=@dateValue"><i class="bi bi-arrow-left"></i>Back to reservations</a>
}

<div class="row md-grid md-section">
    <div class="col-lg-8 col-xl-7">
        @* OnPost → ReservationService.CreateWalkInAsync (the server checks every rule again) *@
        <form method="post" id="walkInForm">
            <section class="md-card">
                <div class="md-card-header">
                    <span class="md-card-label">Booking</span>
                </div>
                <div class="md-card-body">
                    @* Seat now (today only): the guests are at the door – the booking starts now and is Seated straight away *@
                    @if (isToday)
                    {
                        <div class="md-switch-row mb-3">
                            <div>
                                <label class="md-switch-title" for="seatNow">Seat now</label>
                                <span class="md-hint d-block mt-0">The guests are here. The booking starts now and the table is marked occupied.</span>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input md-switch" type="checkbox" role="switch" id="seatNow" name="seatNow" value="true" checked="@Model.SeatNow" />
                            </div>
                        </div>
                    }

                    @* Date reloads the page so the table list shows that day's bookings; time is off while Seat now is on *@
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationDate">Date</label>
                            <input class="form-control md-input" id="reservationDate" name="reservationDate" type="date" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd", inv)" max="@DateTime.Today.AddDays(settings.bookingWindowDays).ToString("yyyy-MM-dd", inv)" value="@dateValue" />
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="reservationTime">Time</label>
                            <input class="form-control md-input" id="reservationTime" name="reservationTime" type="time" step="900" value="@Model.Time" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        @* The table clicked on the floor is chosen. data-busy = that day's bookings on the table *@
                        <div class="col-sm-7">
                            <label class="md-label" for="tableId">Table</label>
                            <select class="form-select md-input" id="tableId" name="tableId" data-md-select>
                                @foreach (var t in Model.Tables)
                                {
                                    <option value="@t.Table.tableID" data-no="@t.Table.tableNumber" data-seats="@t.Table.tableCapacity" data-busy="@t.Busy"
                                            selected="@(t.Table.tableID == Model.TableId)">@t.Table.tableNumber · @t.Table.DiningArea?.areaName · @t.Table.tableCapacity seats</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="md-label" for="partySize">Guests</label>
                            <select class="form-select md-input" id="partySize" name="partySize">
                                @for (int n = settings.minPartySize; n <= settings.maxPartySize; n++)
                                {
                                    <option selected="@(n == Model.PartySize)">@n</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 mt-2">
                            <p class="md-hint mb-0" id="tableInfo"></p>
                            <p class="md-note-box md-note-box-danger mt-2 mb-0 d-none" id="tableTooSmall"></p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="md-card md-section">
                <div class="md-card-header">
                    <span class="md-card-label">Guest details</span>
                </div>
                <div class="md-card-body">
                    @* Choosing a guest fills name, email and phone *@
                    <div class="mb-3">
                        <label class="md-label" for="findGuest">Find existing guest</label>
                        <input class="form-control md-input" id="findGuest" list="guestList" placeholder="Search by name, phone or email" autocomplete="off" />
                        <datalist id="guestList">
                            @foreach (var g in Model.Guests)
                            {
                                <option value="@g.custName · @g.custPhone · @g.custEmail" data-id="@g.custID" data-name="@g.custName" data-phone="@g.custPhone" data-email="@g.custEmail"></option>
                            }
                        </datalist>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="md-label" for="guestName">Guest name</label>
                            <input class="form-control md-input" id="guestName" name="guestName" maxlength="100" placeholder="Guest name" value="@Model.GuestName" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="md-label" for="guestPhone">Phone</label>
                            <input class="form-control md-input" id="guestPhone" name="guestPhone" type="tel" maxlength="20" placeholder="0123456789" value="@Model.GuestPhone" required />
                        </div>
                        <div class="col-12">
                            <label class="md-label" for="guestEmail">Email</label>
                            <input class="form-control md-input" id="guestEmail" name="guestEmail" type="email" maxlength="100" placeholder="guest@example.com" value="@Model.GuestEmail" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="md-label" for="specialRequest">Requests or allergies</label>
                        <textarea class="form-control md-input" id="specialRequest" name="specialRequest" rows="3" maxlength="300" placeholder="e.g. high chair, nut allergy">@Model.SpecialRequest</textarea>
                    </div>
                    <p class="md-hint mb-0">
                        A booking made by staff is confirmed straight away and holds the table for @settings.diningMinutes minutes.
                        The email links it to the guest's account. A guest without an account registers with the same email to see this booking and order from the table.
                    </p>

                    @if (Model.ErrorMessage != null)
                    {
                        <p class="md-note-box md-note-box-danger mt-3 mb-0" role="alert">@Model.ErrorMessage</p>
                    }
                </div>
                <div class="md-card-footer md-walkin-foot">
                    <button type="submit" class="btn btn-md-dark" id="bookButton"><i class="bi bi-calendar-check me-2"></i><span id="bookLabel">Book here</span></button>
                </div>
            </section>
        </form>
    </div>
</div>

@section Scripts {
    @* Table dropdown opens its list below (data-md-select) *@
    <script src="~/js/md-select.js" asp-append-version="true"></script>
    <script>
        (function () {
            var date = document.getElementById('reservationDate');
            var time = document.getElementById('reservationTime');
            var table = document.getElementById('tableId');
            var size = document.getElementById('partySize');
            var seatNow = document.getElementById('seatNow');   // only today
            var book = document.getElementById('bookButton');
            var stay = @settings.diningMinutes;   // minutes a booking holds the table (Admin > Settings)

            function minutes(hhmm) { var p = hhmm.split(':'); return +p[0] * 60 + +p[1]; }
            function nowHHmm() { var d = new Date(); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }

            // Date: reload so the table list shows that day's bookings (keeps the chosen table)
            date.addEventListener('change', function () {
                if (!date.value) return;
                var option = table.options[table.selectedIndex];
                window.location.search = '?date=' + date.value + (option ? '&table=' + encodeURIComponent(option.dataset.no) : '');
            });

            // Table info + clash / size warning for the chosen time and table (the server checks again on Book)
            function apply() {
                var seated = seatNow && seatNow.checked;
                time.disabled = seated;
                document.getElementById('bookLabel').textContent = seated ? 'Seat now' : 'Book here';

                var option = table.options[table.selectedIndex];
                if (!option) return;
                var seats = +option.dataset.seats, guests = +size.value;
                var start = minutes(seated ? nowHHmm() : (time.value || '00:00'));
                var busy = option.dataset.busy ? option.dataset.busy.split(' ') : [];
                var clash = busy.find(function (w) {
                    var p = w.split('-');
                    return start < minutes(p[1]) && minutes(p[0]) < start + stay;
                });

                document.getElementById('tableInfo').textContent = option.dataset.no + ' seats ' + seats + ' · ' +
                    (busy.length ? 'booked ' + busy.join(', ').replace(/-/g, '–') + ' on this day.' : 'no bookings on this day.');

                var problem = guests > seats ? option.dataset.no + ' seats only ' + seats + '. Choose a bigger table for ' + guests + ' guests.'
                    : clash ? option.dataset.no + ' is booked ' + clash.replace('-', '–') + '. Choose another time or table.' : '';
                var warning = document.getElementById('tableTooSmall');
                warning.textContent = problem;
                warning.classList.toggle('d-none', !problem);
                book.disabled = !!problem;
            }

            [time, table, size].forEach(function (el) { el.addEventListener('change', apply); });
            if (seatNow) seatNow.addEventListener('change', apply);
            apply();

            // Find existing guest: fills name, email and phone
            var find = document.getElementById('findGuest');
            function pickGuest(option) {
                document.getElementById('guestName').value = option.dataset.name;
                document.getElementById('guestPhone').value = option.dataset.phone;
                document.getElementById('guestEmail').value = option.dataset.email;
            }
            find.addEventListener('change', function () {
                var value = this.value;
                var option = Array.prototype.find.call(document.querySelectorAll('#guestList option'), function (o) { return o.value === value; });
                if (option) pickGuest(option);
            });

            // ?guest=12: fill in that guest
            var preset = document.querySelector('#guestList option[data-id="@Model.PresetGuestId"]');
            if (preset) { find.value = preset.value; pickGuest(preset); }
        })();
    </script>
}
