@page
@model RestaurantManagementSystem.Pages.Staff.DashboardModel
@using RestaurantManagementSystem.Services
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var now = DateTime.Now;
    var greeting = now.Hour < 12 ? "Good morning" : now.Hour < 17 ? "Good afternoon" : "Good evening";
    var firstName = Model.StaffName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

    ViewData["Title"] = "Dashboard";
    ViewData["Module"] = "Staff";
    ViewData["ActiveNav"] = "Dashboard";
    ViewData["Eyebrow"] = now.ToString("dddd, d MMMM yyyy", inv) + (now.Hour < 16 ? " · Lunch service" : " · Dinner service");
    ViewData["Heading"] = greeting + (firstName != null ? ", " + firstName : "");
    Layout = "_DashboardLayout";

    // Reservations: today's bookings (Pending, Confirmed, Seated, Completed – see DashboardModel.Shown)
    var guests = Model.Guests;
    int Count(string status) => guests.Count(r => r.reservationStatus == status);
    var pending = Count(ReservationStatus.Pending);
    var handled = guests.Count - pending;
    string[] endedStatuses = { ReservationStatus.Completed, ReservationStatus.Cancelled, ReservationStatus.NoShow, ReservationStatus.Declined };
}

@* Reservations (stat cards 1–2 + Upcoming guests) come from the database.
   Orders (stat cards 3–4 + Active orders) are still example data – they belong to the orders / billing feature.
   Order statuses: Order placed → Preparing → Served → Completed (or Cancelled before Served)

   This dashboard has no action buttons on its rows. Clicking a reservation opens the Reservation
   details pop-up here (Confirm / Seat / Decline … inside it); clicking an order opens the Orders page. *@

@section HeaderActions {
    <a class="btn btn-md-outline md-header-btn" href="/Staff/WalkIn"><i class="bi bi-plus-lg"></i>Seat walk-in</a>
}

@* Message after an action in the Reservation details pop-up (TempData["StaffMessage"]; red when it failed) *@
@if (TempData["StaffMessage"] is string message)
{
    if (TempData["StaffMessageIsError"] is true)
    {
        <p class="md-note-box md-note-box-danger md-section" role="alert">@message</p>
    }
    else
    {
        <div class="md-alert-success md-section" role="status"><i class="bi bi-check-circle me-2"></i>@message</div>
    }
}

@* ---------- Tonight at a glance: 4 simple stat cards ----------
   Each card: label, number, one thin bar, one link.
   Bar colours match the status tags.
   Bar parts use flex = count (e.g. flex: 7 and flex: 2 for 7 handled + 2 pending). *@
<div class="row md-grid md-section">
    @* Reservations today: blue = handled (Confirmed/Seated/Completed), red = Pending (same red as the Pending tag) *@
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Reservations today</span>
            <div class="md-stat-value">@guests.Count</div>
            <div class="md-statbar" role="img" aria-label="@handled handled, @pending pending approval">
                <i class="is-blue" style="flex: @handled"></i>
                <i class="is-red" style="flex: @pending"></i>
            </div>
            @* Link counts Pending requests on ALL upcoming days (the number and bar above are today only), names the day
               ("· Tomorrow", or "· next: Tue 28 Oct" when they are on several days) and opens the earliest day *@
            @if (Model.PendingUpcoming > 0)
            {
                var firstDay = Model.PendingFirstDate!.Value;
                var dayName = firstDay == DateTime.Today ? "Today" : firstDay == DateTime.Today.AddDays(1) ? "Tomorrow" : firstDay.ToString("ddd d MMM", inv);
                <a class="md-stat-action" href="/Staff/Reservations?date=@firstDay.ToString("yyyy-MM-dd", inv)&status=Pending">
                    @Model.PendingUpcoming @(Model.PendingUpcoming == 1 ? "request needs" : "requests need") approval · @(Model.PendingDays > 1 ? "next: " : "")@dayName <i class="bi bi-arrow-right"></i>
                </a>
            }
            else
            {
                <a class="md-stat-action" href="/Staff/Reservations">None need approval <i class="bi bi-arrow-right"></i></a>
            }
        </div>
    </div>

    @* Tables occupied: blue = occupied out of all tables (grey track = the rest) *@
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Tables occupied</span>
            <div class="md-stat-value">@Model.TablesOccupied <small>/ @Model.TablesTotal</small></div>
            <div class="md-statbar" role="img" aria-label="@Model.TablesOccupied of @Model.TablesTotal tables occupied">
                <i class="is-blue" style="flex: @Model.TablesOccupied"></i>
                <i style="flex: @(Model.TablesTotal - Model.TablesOccupied)"></i>
            </div>
            <a class="md-stat-action" href="/Staff/WalkIn">Book reservations <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>

    @* ---- Example data from here (orders feature) ---- *@
    @* Open orders: orange = Preparing, yellow = Order placed (same colours as the order tags) (waiting to be accepted) *@
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Open orders</span>
            <div class="md-stat-value">3</div>
            <div class="md-statbar" role="img" aria-label="2 preparing, 1 waiting to be accepted">
                <i class="is-orange" style="flex: 2"></i>
                <i class="is-yellow" style="flex: 1"></i>
            </div>
            <a class="md-stat-action" href="/Staff/Orders?status=placed">1 to accept <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>

    @* Awaiting payment: total of Served orders not yet Paid; full blue bar (blue = Served, same as the Served tag) *@
    <div class="col-sm-6 col-xl-3">
        <div class="md-stat md-staff-stat">
            <span class="md-label">Awaiting payment</span>
            <div class="md-stat-value">RM 436.08</div>
            <div class="md-statbar" role="img" aria-label="1 bill waiting for payment">
                <i class="is-blue" style="flex: 1"></i>
            </div>
            <a class="md-stat-action" href="/Staff/Billing?order=ORD-0083">1 bill · <i class="bi bi-lamp md-lamp" aria-hidden="true"></i>T-09 <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>

<div class="row md-grid md-section">
    @* ---------- Today's reservations: upcoming guests ----------
       Pills show the reservation status (reservationStatus "Seated" = the guests have arrived).
       Colours: Pending red · Confirmed blue · Seated yellow · Completed green.
       Cancelled, Declined and No-show reservations are NOT shown here (DashboardModel.Shown) – see the Reservations page.
       Clicking a row opens the Reservation details pop-up here on the Dashboard (Pages/Staff/_ReservationDetailPopup,
       staff-reservation-popup.js); actions post to /Staff/Reservations and come back here. ?view=R-0043 opens it too.
       The header (eyebrow + title + arrow) is also clickable and opens the Reservations page. *@
    <div class="col-xl-7">
        <section class="md-card h-100 md-panel">
            <div class="md-panel-head md-row-link">
                <div>
                    <span class="md-eyebrow">Today's reservations</span>
                    <h2 class="md-panel-title">Upcoming guests</h2>
                </div>
                <a class="md-circle-btn stretched-link" href="/Staff/Reservations" aria-label="All reservations"><i class="bi bi-chevron-right"></i></a>
            </div>

            @* Filter tabs: show only rows whose class matches (is-pending, is-confirmed …) *@
            <nav class="md-tabs md-filter-tabs" aria-label="Reservation status" data-filter-list="guestList">
                <button type="button" class="active" data-filter="all">All <small>@guests.Count</small></button>
                @foreach (var s in RestaurantManagementSystem.Pages.Staff.DashboardModel.Shown)
                {
                    <button type="button" data-filter="@StaffReservationText.StatusClass(s)">@s <small>@Count(s)</small></button>
                }
            </nav>

            @if (guests.Count == 0)
            {
                <p class="md-empty">No reservations today.</p>
            }
            @* Earliest first. data-* values fill the Reservation details pop-up (staff-reservation-popup.js) *@
            <ul class="md-guest-list" id="guestList">
                @foreach (var r in guests)
                {
                    var key = StaffReservationText.StatusClass(r.reservationStatus);
                    var code = ReservationService.Code(r);
                    var name = r.Customer?.custName ?? "Guest";
                    var time = r.reservationDateTime.ToString("HH:mm", inv);
                    var tableNo = r.DiningTable?.tableNumber;
                    var area = r.DiningTable?.DiningArea?.areaName;
                    var ended = endedStatuses.Contains(r.reservationStatus);
                    <li class="md-guest md-row-link @key" data-id="@r.reservationID" data-code="@code" data-name="@name" data-guests="@r.partySize"
                        data-date="@r.reservationDateTime.ToString("yyyy-MM-dd", inv)" data-time="@time" data-table="@tableNo" data-table-id="@r.tableID" data-today="true"
                        data-status="@r.reservationStatus" data-walkin="false" data-booked="@StaffReservationText.Booked(r)"
                        data-request="@(ended ? "" : r.specialRequest)" data-details="@name · @time · @r.partySize guests · @tableNo @area"
                        data-free="@(ended ? "" : StaffReservationText.NextOnTable(r, Model.Today, Model.Settings.diningMinutes))">
                        <div class="md-guest-time">@time<span>@(r.reservationDateTime.Hour < 16 ? "Lunch" : "Tonight")</span></div>
                        <div class="md-guest-main">
                            <a class="stretched-link md-guest-name" href="?view=@code" data-open-detail>@name <span class="md-guest-code">@code</span></a>
                            <span class="md-guest-meta"><i class="bi bi-people"></i>@r.partySize guests · <i class="bi bi-lamp md-lamp" aria-hidden="true"></i>@tableNo · @(r.specialRequest ?? area)</span>
                        </div>
                        <span class="md-pill @key">@r.reservationStatus</span>
                    </li>
                }
            </ul>
        </section>
    </div>

    @* ---------- Active orders: kitchen & service ---------- *@
    <div class="col-xl-5">
        <section class="md-card h-100 md-panel">
            <div class="md-panel-head md-row-link">
                <div>
                    <span class="md-eyebrow">Kitchen &amp; service</span>
                    <h2 class="md-panel-title">Active orders</h2>
                </div>
                <a class="md-circle-btn stretched-link" href="/Staff/Orders" aria-label="All orders"><i class="bi bi-chevron-right"></i></a>
            </div>

            @* Filter tabs by order status (counts replace the old summary strip) *@
            <nav class="md-tabs md-filter-tabs" aria-label="Order status" data-filter-list="orderList">
                <button type="button" class="active" data-filter="all">All <small>4</small></button>
                <button type="button" data-filter="is-placed">Order placed <small>1</small></button>
                <button type="button" data-filter="is-preparing">Preparing <small>2</small></button>
                <button type="button" data-filter="is-served">Served <small>1</small></button>
            </nav>

            @* Newest action first: Order placed → Preparing → Served.
               Colours: Order placed yellow · Preparing orange · Served blue.
               Completed and Cancelled orders are NOT shown here (only open orders:
               orderStatus is "Order placed", "Preparing" or "Served").
               Each row is a link (stretched-link) to the Orders page with that order shown (?view=ORD-0085). *@
            <ul class="md-order-list" id="orderList">
                <li class="md-order md-row-link is-placed">
                    <span class="md-table-badge">03</span>
                    <div class="md-order-main">
                        <a class="stretched-link md-guest-name" href="/Staff/Orders?view=ORD-0085">Daniel Tan</a>
                        <span class="md-guest-meta">ORD-0085 · 2 items</span>
                    </div>
                    <div class="md-order-side">
                        <span class="md-pill is-placed">Order placed</span>
                        <span class="md-order-amount">RM 134.00</span>
                    </div>
                </li>
                <li class="md-order md-row-link is-preparing">
                    <span class="md-table-badge">12</span>
                    <div class="md-order-main">
                        <a class="stretched-link md-guest-name" href="/Staff/Orders?view=ORD-0082">Eleanor Whitmore</a>
                        <span class="md-guest-meta">ORD-0082 · 8 items</span>
                    </div>
                    <div class="md-order-side">
                        <span class="md-pill is-preparing">Preparing</span>
                        <span class="md-order-amount">RM 676.00</span>
                    </div>
                </li>
                <li class="md-order md-row-link is-preparing">
                    <span class="md-table-badge">06</span>
                    <div class="md-order-main">
                        <a class="stretched-link md-guest-name" href="/Staff/Orders?view=ORD-0081">Marcus Delacroix</a>
                        <span class="md-guest-meta">ORD-0081 · 5 items</span>
                    </div>
                    <div class="md-order-side">
                        <span class="md-pill is-preparing">Preparing</span>
                        <span class="md-order-amount">RM 387.00</span>
                    </div>
                </li>
                <li class="md-order md-row-link is-served">
                    <span class="md-table-badge">09</span>
                    <div class="md-order-main">
                        <a class="stretched-link md-guest-name" href="/Staff/Orders?view=ORD-0083">Thomas Ashford</a>
                        <span class="md-guest-meta">ORD-0083 · 4 items</span>
                    </div>
                    <div class="md-order-side">
                        <span class="md-pill is-served">Served</span>
                        <span class="md-order-amount">RM 374.00</span>
                    </div>
                </li>
            </ul>
        </section>
    </div>
</div>

@* Reservation details pop-up + its confirm pop-ups (same as the Reservations page); actions come back here *@
<partial name="_ReservationDetailPopup" model="@("/Staff/Dashboard")" />

@section Scripts {
    <script>
        // Filter tabs: show only the rows whose class matches the chosen status.
        // The chosen tab survives the automatic refresh (sessionStorage).
        document.querySelectorAll('.md-filter-tabs').forEach(function (tabs) {
            var list = document.getElementById(tabs.dataset.filterList);
            var storeKey = 'staffDashTab:' + tabs.dataset.filterList;
            function choose(button) {
                tabs.querySelectorAll('button').forEach(function (b) { b.classList.toggle('active', b === button); });
                list.querySelectorAll(':scope > li').forEach(function (row) {
                    var show = button.dataset.filter === 'all' || row.classList.contains(button.dataset.filter);
                    row.classList.toggle('d-none', !show);
                });
            }
            tabs.querySelectorAll('button').forEach(function (button) {
                button.addEventListener('click', function () {
                    choose(button);
                    try { sessionStorage.setItem(storeKey, button.dataset.filter); } catch (e) { }
                });
            });
            try {
                var saved = sessionStorage.getItem(storeKey);
                var savedButton = saved && tabs.querySelector('button[data-filter="' + saved + '"]');
                if (savedButton) choose(savedButton);
            } catch (e) { }
        });
    </script>
    @* Table dropdowns open their list below (data-md-select) *@
    <script src="~/js/md-select.js" asp-append-version="true"></script>
    @* Reservation details pop-up (opens from an Upcoming guests row, or ?view=R-0043) *@
    <script src="~/js/staff-reservation-popup.js" asp-append-version="true"></script>
    @* Reloads every minute while no pop-up is open and nothing is being typed *@
    <script src="~/js/staff-auto-refresh.js" asp-append-version="true"></script>
}