@model string
@using Microsoft.EntityFrameworkCore
@inject RestaurantManagementSystem.Data.ApplicationDbContext Db
@inject RestaurantManagementSystem.Services.SettingsService SettingsService
@*
    Staff – Reservation details pop-up + its confirm pop-ups (Decline, Cancel, No-show).
    Used by /Staff/Reservations and /Staff/Dashboard:
        <partial name="_ReservationDetailPopup" model="@("/Staff/Dashboard")" />      (model = page to return to)
        <script src="~/js/staff-reservation-popup.js"></script>
    A booking row opens it when it has the data-* values listed in staff-reservation-popup.js
    and a link with data-open-detail. All forms post to the /Staff/Reservations handlers with returnUrl,
    so after an action the staff member goes back to the page they were on.
*@
@{
    string returnUrl = Model;

    // Tables for the Table dropdown (value = tableID). Maintenance tables can't be chosen.
    // Whether a table is free at the booking's time is checked by the server on Save (ReservationService.UpdateByStaffAsync).
    var tables = await Db.DiningTables.AsNoTracking().Include(t => t.DiningArea).OrderBy(t => t.tableNumber).ToListAsync();
    var settings = await SettingsService.GetAsync();
}

@* ---------- Reservation details pop-up ----------
   Filled by staff-reservation-popup.js from the clicked row. The footer buttons post the form to
   OnPostSave / OnPostConfirm / OnPostSeat; Decline, No-show and Cancel open their confirm pop-up.
   Seated, Completed, Cancelled, No-show and Declined bookings are read-only (no footer).
   A Seated booking becomes Completed by itself when its order is paid (Billing). *@
<div class="modal fade md-popup" id="reservationDetailPopup" tabindex="-1" aria-labelledby="reservationDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-page="/Staff/Reservations" asp-page-handler="Save" id="detailForm">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow" data-detail="eyebrow">Reservation</span>
                    <h2 class="modal-title md-popup-title" id="reservationDetailTitle" data-detail="title">—</h2>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="md-pill" data-detail="pill">—</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <input type="hidden" name="reservationId" data-detail="id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <p class="md-hint mt-0 mb-3" data-detail="booked">—</p>
                <fieldset class="md-profile-fields md-detail-fields" data-detail="fields">
                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label class="md-label" for="detailDate">Date</label>
                            <input class="form-control md-input" id="detailDate" name="reservationDate" type="date" required />
                        </div>
                        <div class="col-sm-4">
                            @* Only the free times for the chosen table (Availability lookup, staff-reservation-popup.js) *@
                            <label class="md-label" for="detailTime">Time</label>
                            <select class="form-select md-input" id="detailTime" name="reservationTime" required></select>
                        </div>
                        <div class="col-sm-4">
                            <label class="md-label" for="detailGuests">Guests</label>
                            <select class="form-select md-input" id="detailGuests" name="partySize">
                                @for (int n = settings.minPartySize; n <= settings.maxPartySize; n++)
                                {
                                    <option>@n</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* Changing the table (Pending / Confirmed only). Tables busy at the chosen time are marked and can't be picked;
                       the server checks again on Save. *@
                    <div class="mb-3">
                        <label class="md-label" for="detailTable">Table</label>
                        <select class="form-select md-input" id="detailTable" name="tableId" data-md-select>
                            @foreach (var t in tables)
                            {
                                <option value="@t.tableID" data-state="@(t.tableStatus == "Maintenance" ? "unavailable" : "free")">@t.tableNumber · @t.DiningArea?.areaName · @t.tableCapacity seats@(t.tableStatus == "Maintenance" ? " · out of service" : "")</option>
                            }
                        </select>
                    </div>
                    <p class="md-note-box md-note-box-info" data-detail="free">—</p>

                    @* Read-only: the guest's own words (not posted – staff can't change it) *@
                    <div>
                        <label class="md-label" for="detailRequest">Special request (from the guest)</label>
                        <textarea class="form-control md-input" id="detailRequest" rows="2" readonly placeholder="None"></textarea>
                    </div>
                </fieldset>
                <p class="md-hint mt-3 mb-0 d-none" data-detail="readonly">—</p>
            </div>

            @* Buttons per status (the script shows the matching group) *@
            <div class="modal-footer md-detail-footer" data-detail="footer">
                <div class="md-edit-actions" data-for="Pending">
                    <button type="button" class="btn md-btn-round md-btn-cancel" data-open-popup="declinePopup">Decline</button>
                    <button type="submit" class="btn md-btn-round md-btn-confirm" asp-page="/Staff/Reservations" asp-page-handler="Confirm">Confirm booking</button>
                </div>
                <div class="md-edit-actions" data-for="Confirmed">
                    <button type="button" class="btn md-btn-round md-btn-cancel" data-open-popup="cancelBookingPopup">Cancel booking</button>
                    @* data-today-only: shown only for today's bookings (arrival tracking) *@
                    <button type="button" class="btn md-btn-round md-btn-outline" data-open-popup="noShowPopup" data-today-only>No-show</button>
                    <button type="submit" class="btn md-btn-round md-btn-green" asp-page="/Staff/Reservations" asp-page-handler="Seat" data-today-only>Seat guests</button>
                </div>
                @* Dark until something is changed, then solid green (staff-reservation-popup.js) *@
                <button type="submit" class="btn md-btn-round btn-md-dark" data-detail="save">Save changes</button>
            </div>
        </form>
    </div>
</div>

@* ---------- Discard changes? ----------
   Opened by staff-reservation-popup.js when the details pop-up is closed (×, Esc, click outside) or Decline / Cancel /
   No-show is clicked while the date, time, guests or table were changed and not saved yet.
   Keep editing goes back to the details pop-up with the changes; Discard changes closes it (or goes on to the action).
   Refresh / browser back / closing the tab show the browser's own "Leave site?" message instead. *@
<div class="modal fade md-popup" id="discardEditPopup" tabindex="-1" aria-labelledby="discardEditTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="md-eyebrow">Reservation</span>
                    <h2 class="modal-title md-popup-title" id="discardEditTitle">Discard changes?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="md-popup-message mb-3" id="discardEditSummary">—</p>
                <p class="md-note-box md-note-box-info mb-0">These changes haven't been saved yet. Discarding keeps the booking as it was.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn md-btn-round md-btn-outline" data-bs-dismiss="modal">Keep editing</button>
                <button type="button" class="btn md-btn-round md-btn-danger" id="discardEditConfirm">Discard changes</button>
            </div>
        </div>
    </div>
</div>

@* ---------- Confirm pop-ups (shared _ConfirmPopup), filled from the clicked button (data-id / data-code / data-details) ----------
   The reason is not saved yet (no column on Reservation, and no Notifications table yet). *@
@{
    var declinePopup = new ConfirmPopupView
    {
        Id = "declinePopup", Eyebrow = "Reservation", Title = "Decline {code}?", Message = "{details}",
        Note = "The booking is marked Declined and the table is freed.",
        Page = "/Staff/Reservations", Handler = "Decline", IdField = "reservationId", ReturnUrl = returnUrl,
        Reasons = new[] { "Fully booked at this time", "Party too large for available tables", "Outside opening hours", "Other" },
        BackText = "Keep request", ConfirmText = "Decline booking", Danger = true
    };
    var cancelBookingPopup = new ConfirmPopupView
    {
        Id = "cancelBookingPopup", Eyebrow = "Reservation", Title = "Cancel {code}?", Message = "{details}",
        Note = "The booking is marked Cancelled and the table is freed.",
        Page = "/Staff/Reservations", Handler = "Cancel", IdField = "reservationId", ReturnUrl = returnUrl,
        Reasons = new[] { "Requested by guest", "Restaurant closure", "Duplicate booking", "Other" },
        BackText = "Keep booking", ConfirmText = "Cancel booking", Danger = true
    };
    var noShowPopup = new ConfirmPopupView
    {
        Id = "noShowPopup", Eyebrow = "Reservation", Title = "Mark {code} as no-show?", Message = "{details}",
        Note = $"The booking is marked No-show and the table is freed. Allowed from {settings.lateHoldMinutes} minutes after the booking time.",
        Page = "/Staff/Reservations", Handler = "NoShow", IdField = "reservationId", ReturnUrl = returnUrl,
        BackText = "Go back", ConfirmText = "Mark no-show", Danger = true
    };
}
<partial name="~/Pages/Shared/Popups/_ConfirmPopup.cshtml" model="declinePopup" />
<partial name="~/Pages/Shared/Popups/_ConfirmPopup.cshtml" model="cancelBookingPopup" />
<partial name="~/Pages/Shared/Popups/_ConfirmPopup.cshtml" model="noShowPopup" />
